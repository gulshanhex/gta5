# ---------------------------------------------------------------------------
# .gitignore  —  GTA V: Los Santos 3D Web Edition (Astro + Cloudflare Workers)
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Astro / Vite caches
.astro/
.vite/

# Cloudflare Wrangler local state & secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Environment / secrets (never commit)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo

# Editor / OS junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# ---------------------------------------------------------------------------
# NOTE on ./dist
# ---------------------------------------------------------------------------
# dist/ is intentionally NOT ignored here. The prebuilt Worker output
# (dist/_worker.js/index.js + the static assets) is committed so that
# `npx wrangler deploy` works straight from a fresh clone with no build step.
#
# If you would rather build on every deploy (Cloudflare Git integration or
# `npm run deploy`), uncomment the next line:
#
# dist/
