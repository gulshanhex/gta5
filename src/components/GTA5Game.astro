---
// GTA5Game.astro — Main 3D WebGL Open-World Game Component for Astro + Cloudflare Workers
---

<!-- GTA V: LOS SANTOS 3D WEB EDITION — FULL UI, HUD & 3D WEBGL ENGINE -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Teko:wght@600;700&display=swap');
  * { box-sizing: border-box; user-select: none; -webkit-user-select: none; }
  html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #060911; font-family: 'Inter', sans-serif; color: #f8fafc; }
  .font-gta { font-family: 'Teko', sans-serif; letter-spacing: 0.04em; }
  #webgl-container { position: fixed; inset: 0; width: 100vw; height: 100vh; z-index: 1; }
  #hud-layer { position: fixed; inset: 0; pointer-events: none; z-index: 10; display: flex; flex-direction: column; justify-content: space-between; }
  .hud-interactive { pointer-events: auto; }
  @keyframes pulseStar { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.35; transform: scale(0.92); } }
  .star-blink { animation: pulseStar 0.7s infinite ease-in-out; }
  @keyframes missionBannerAnim { 0% { transform: scale(0.8); opacity: 0; } 15% { transform: scale(1.03); opacity: 1; } 85% { transform: scale(1); opacity: 1; } 100% { transform: scale(0.95); opacity: 0; } }
  .mission-passed-banner { animation: missionBannerAnim 4.2s forwards; }
  ::-webkit-scrollbar { width: 5px; height: 5px; }
  ::-webkit-scrollbar-track { background: rgba(15,23,42,0.6); }
  ::-webkit-scrollbar-thumb { background: rgba(148,163,184,0.4); border-radius: 4px; }
</style>

<!-- 3D WebGL Viewport -->
<div id="webgl-container"></div>

<!-- Screen Filter Overlay (Special Abilities: Bullet Time / Driving Focus / Red Mist / Damage / SkyCam) -->
<div id="screen-fx-overlay" class="fixed inset-0 pointer-events-none z-[5] transition-all duration-300" style="opacity:0;"></div>

<!-- Crosshair & Hit Marker -->
<div id="crosshair-wrap" class="fixed inset-0 pointer-events-none z-[8] flex items-center justify-center">
  <div id="crosshair-dot" class="relative w-6 h-6 flex items-center justify-center transition-transform duration-75">
    <div class="w-1.5 h-1.5 bg-white rounded-full shadow-[0_0_6px_#000]"></div>
    <div class="absolute w-4 h-[1.5px] bg-white/80 -left-3"></div>
    <div class="absolute w-4 h-[1.5px] bg-white/80 -right-3"></div>
    <div class="absolute h-4 w-[1.5px] bg-white/80 -top-3"></div>
    <div class="absolute h-4 w-[1.5px] bg-white/80 -bottom-3"></div>
  </div>
</div>

<!-- Sky-Cam Character Transition Overlay -->
<div id="skycam-banner" class="fixed top-20 left-1/2 -translate-x-1/2 z-[25] hidden pointer-events-none bg-slate-950/85 border border-white/20 px-6 py-2.5 rounded-full shadow-2xl backdrop-blur-md">
  <div class="flex items-center gap-3">
    <div class="w-3 h-3 rounded-full bg-amber-400 animate-ping"></div>
    <span id="skycam-text" class="font-gta text-2xl uppercase tracking-wider text-amber-300">SAT-CAM: SWITCHING TO FRANKLIN CLINTON...</span>
  </div>
</div>

<!-- Mission Passed / Heist Complete Overlay -->
<div id="mission-banner" class="fixed inset-0 z-[35] hidden pointer-events-none flex flex-col items-center justify-center bg-black/45 backdrop-blur-[2px]">
  <div class="text-center px-8 py-6 rounded-2xl bg-slate-950/90 border-y-4 border-amber-400 shadow-[0_0_50px_rgba(245,158,11,0.5)]">
    <div id="mission-banner-title" class="font-gta text-6xl sm:text-7xl font-bold text-amber-400 drop-shadow-[0_4px_10px_rgba(0,0,0,0.9)] tracking-widest">MISSION PASSED</div>
    <div id="mission-banner-sub" class="text-xl sm:text-2xl font-bold text-emerald-400 mt-1">+$250,000 • RESPECT +100</div>
  </div>
</div>

<!-- WASTED / BUSTED Fullscreen Overlay -->
<div id="wasted-overlay" class="fixed inset-0 z-[40] hidden pointer-events-none flex flex-col items-center justify-center bg-red-950/70 backdrop-blur-sm">
  <div id="wasted-title" class="font-gta text-7xl sm:text-9xl font-black tracking-widest text-red-500 drop-shadow-[0_6px_20px_rgba(0,0,0,0.95)]">WASTED</div>
  <div id="wasted-sub" class="text-base sm:text-lg font-semibold text-white/90 bg-black/60 px-5 py-2 rounded-full mt-2">Respawning at Pillbox Hill Medical Center (-$500 Hospital Bill)...</div>
</div>

<!-- START / LOADING SPLASH MODAL -->
<div id="splash-modal" class="fixed inset-0 z-[50] flex items-center justify-center p-3 sm:p-6 bg-slate-950/95 backdrop-blur-md overflow-y-auto">
  <div class="relative w-full max-w-4xl rounded-2xl overflow-hidden border border-white/15 bg-slate-900 shadow-[0_25px_70px_rgba(0,0,0,0.85)] my-auto">
    <!-- Hero Banner -->
    <div class="relative h-48 sm:h-64 w-full bg-slate-800 overflow-hidden">
      <img id="splash-hero-img" src="/textures/los_santos_hero.jpg" alt="GTA V Los Santos Skyline" class="w-full h-full object-cover object-center opacity-90 max-w-full" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
      <div class="absolute top-3 left-4 flex flex-wrap items-center gap-2">
        <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-amber-500 text-slate-950 shadow">Astro + Cloudflare Workers</span>
        <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">10 Pure .GLB 3D Assets Loaded</span>
        <span class="px-2.5 py-1 rounded-md text-xs font-semibold bg-sky-500/20 text-sky-300 border border-sky-400/30">Zero D1 / Zero R2 (public/ Static)</span>
      </div>
      <div class="absolute bottom-3 left-4 right-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <h1 class="font-gta text-4xl sm:text-6xl font-bold leading-none text-white drop-shadow-lg">GRAND THEFT AUTO V: <span class="text-amber-400">LOS SANTOS 3D</span></h1>
          <p class="text-xs sm:text-sm text-slate-300">Open-World 3D Browser Game • 3 Protagonists • Heists • Vehicles & Helicopters • 5-Star LSPD AI</p>
        </div>
      </div>
    </div>

    <!-- Splash Content -->
    <div class="p-4 sm:p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Column 1: Choose Starting Protagonist -->
      <div class="bg-slate-950/70 border border-white/10 rounded-xl p-3.5">
        <div class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2">1. Select Starting Protagonist</div>
        <div class="space-y-2">
          <button type="button" data-start-char="michael" class="start-char-btn w-full text-left p-2.5 rounded-lg border border-sky-400 bg-sky-500/20 flex items-center justify-between transition">
            <div>
              <div class="font-bold text-sm text-white">Michael De Santa</div>
              <div class="text-[11px] text-sky-300">Special: Bullet Time • $450,000</div>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-sky-500 text-slate-950">Downtown</span>
          </button>
          <button type="button" data-start-char="franklin" class="start-char-btn w-full text-left p-2.5 rounded-lg border border-white/10 bg-slate-900/60 hover:bg-slate-800/80 flex items-center justify-between transition">
            <div>
              <div class="font-bold text-sm text-white">Franklin Clinton</div>
              <div class="text-[11px] text-emerald-300">Special: Driving Slow-Mo • $85,000</div>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-500 text-slate-950">Vinewood</span>
          </button>
          <button type="button" data-start-char="trevor" class="start-char-btn w-full text-left p-2.5 rounded-lg border border-white/10 bg-slate-900/60 hover:bg-slate-800/80 flex items-center justify-between transition">
            <div>
              <div class="font-bold text-sm text-white">Trevor Philips</div>
              <div class="text-[11px] text-amber-300">Special: Red Mist Rage • $165,000</div>
            </div>
            <span class="text-xs font-bold px-2 py-0.5 rounded bg-amber-500 text-slate-950">Airfield</span>
          </button>
        </div>
      </div>

      <!-- Column 2: Low-End Device Graphics Mode -->
      <div class="bg-slate-950/70 border border-white/10 rounded-xl p-3.5">
        <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2">2. Device & GPU Optimization</div>
        <div class="space-y-2">
          <button type="button" data-gfx-preset="low" class="gfx-preset-btn w-full text-left p-2.5 rounded-lg border border-white/10 bg-slate-900/60 hover:bg-slate-800/80 transition">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-white">Potato / Low-End Device</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300">60 FPS Boost</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">0.65x Resolution, Fast Fog, Low Traffic (Best for integrated GPUs & mobile)</div>
          </button>
          <button type="button" data-gfx-preset="balanced" class="gfx-preset-btn w-full text-left p-2.5 rounded-lg border border-emerald-400 bg-emerald-500/20 transition">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-white">Balanced (Recommended)</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-400 text-slate-950 font-bold">Default</span>
            </div>
            <div class="text-[11px] text-slate-300 mt-0.5">1.0x Resolution, Dynamic Adaptive FPS Scaler, Full City & Traffic</div>
          </button>
          <button type="button" data-gfx-preset="high" class="gfx-preset-btn w-full text-left p-2.5 rounded-lg border border-white/10 bg-slate-900/60 hover:bg-slate-800/80 transition">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-white">Ultra Los Santos</span>
              <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/20 text-purple-300">Max Draw</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">High-DPI Retina, Extended Draw Distance, Dense Traffic & Particles</div>
          </button>
        </div>
      </div>

      <!-- Column 3: Controls & Pure 3D GLB Status -->
      <div class="bg-slate-950/70 border border-white/10 rounded-xl p-3.5 flex flex-col justify-between">
        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-sky-400 mb-2">3. Controls & Keybindings</div>
          <div class="grid grid-cols-2 gap-x-2 gap-y-1 text-[11px] text-slate-300">
            <div><strong class="text-white">WASD / Arrows:</strong> Move / Drive</div>
            <div><strong class="text-white">F / Enter:</strong> Hijack Vehicle</div>
            <div><strong class="text-white">Left Click / Space:</strong> Shoot / Brake</div>
            <div><strong class="text-white">1 / 2 / 3:</strong> Switch Character</div>
            <div><strong class="text-white">Q:</strong> Special Ability</div>
            <div><strong class="text-white">Tab:</strong> Weapon Wheel</div>
            <div><strong class="text-white">P:</strong> iFruit Phone</div>
            <div><strong class="text-white">R:</strong> Radio Wheel</div>
            <div><strong class="text-white">G:</strong> LS Customs Mod</div>
            <div><strong class="text-white">V:</strong> Camera View</div>
          </div>
          <div id="glb-loader-status" class="mt-3 p-2 rounded-lg bg-slate-900 border border-white/10 text-[11px] text-emerald-300">
            ✓ All 10 binary glTF 2.0 (.glb) 3D models ready in <code>public/models/</code>
          </div>
        </div>
        <button id="btn-launch-game" type="button" class="mt-3 w-full py-3 px-4 rounded-xl bg-gradient-to-r from-amber-500 via-orange-500 to-emerald-500 hover:brightness-110 text-slate-950 font-gta text-2xl font-bold tracking-wider uppercase shadow-lg transition cursor-pointer">
          ▶ ENTER LOS SANTOS (START GAME)
        </button>
      </div>
    </div>
  </div>
</div>

<!-- MAIN IN-GAME HUD LAYER -->
<div id="hud-layer">
  <!-- TOP BAR: Zone Name, Mission Objective, FPS/Low-End Status, Cash, Wanted Stars & Quick Actions -->
  <div class="w-full p-2.5 sm:p-4 flex flex-wrap items-start justify-between gap-2">
    <!-- Top-Left: District, Time, FPS & Quick Toolbar -->
    <div class="flex flex-col gap-1.5 hud-interactive">
      <div class="flex flex-wrap items-center gap-1.5 bg-slate-950/80 border border-white/15 px-3 py-1.5 rounded-xl backdrop-blur-md shadow-lg">
        <span id="hud-district" class="font-gta text-xl sm:text-2xl text-amber-400 leading-none">DOWNTOWN LOS SANTOS</span>
        <span class="text-slate-600">•</span>
        <span id="hud-clock" class="text-xs font-mono font-bold text-slate-200">14:00</span>
        <span id="hud-weather-badge" class="text-[11px] px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 font-semibold">☀ Clear</span>
        <span id="hud-fps" class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-bold">60 FPS</span>
      </div>

      <!-- Quick Action Bar for Desktop & Mobile -->
      <div class="flex flex-wrap items-center gap-1">
        <button id="btn-hud-weapons" type="button" class="px-2.5 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold flex items-center gap-1 shadow cursor-pointer">
          <span>🔫</span><span id="hud-active-weapon">Combat Pistol</span><span class="text-slate-400" id="hud-active-ammo">(∞)</span>
        </button>
        <button id="btn-hud-phone" type="button" class="px-2.5 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold flex items-center gap-1 shadow cursor-pointer">
          <span>📱</span><span>iFruit (P)</span>
        </button>
        <button id="btn-hud-radio" type="button" class="px-2.5 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold flex items-center gap-1 shadow cursor-pointer">
          <span>📻</span><span id="hud-radio-label">Non-Stop-Pop FM</span>
        </button>
        <button id="btn-hud-lscustoms" type="button" class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-300 text-xs font-semibold flex items-center gap-1 shadow cursor-pointer">
          <span>🔧</span><span>LS Customs (G)</span>
        </button>
        <button id="btn-hud-ammunation" type="button" class="px-2.5 py-1 rounded-lg bg-red-500/20 hover:bg-red-500/30 border border-red-400/40 text-red-300 text-xs font-semibold flex items-center gap-1 shadow cursor-pointer">
          <span>🎯</span><span>Ammu-Nation</span>
        </button>
        <button id="btn-hud-camera" type="button" class="px-2 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold shadow cursor-pointer" title="Toggle Camera View (V)">
          🎥 <span id="hud-cam-mode">3rd Person</span>
        </button>
        <button id="btn-hud-audio" type="button" class="px-2 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold shadow cursor-pointer" title="Toggle Sound">
          🔊
        </button>
        <button id="btn-hud-heist" type="button" class="px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/40 text-emerald-300 text-xs font-semibold shadow cursor-pointer" title="Heist Planning Board (H)">
          💎 Heist Board
        </button>
        <button id="btn-hud-map" type="button" class="px-2.5 py-1 rounded-lg bg-purple-500/20 hover:bg-purple-500/30 border border-purple-400/40 text-purple-300 text-xs font-semibold shadow cursor-pointer" title="Pause Map, Saves & Credits (M)">
          🗺 Map & Saves
        </button>
        <button id="btn-hud-theme" type="button" class="px-2.5 py-1 rounded-lg bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/40 text-sky-300 text-xs font-semibold shadow cursor-pointer" title="Switch Original vs Working-Title Names">
          🎭 <span id="hud-theme-label">Original Cast</span>
        </button>
        <button id="btn-hud-lang" type="button" class="px-2 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold shadow cursor-pointer" title="Switch Language (EN / HI)">
          🌐 <span id="hud-lang-label">EN</span>
        </button>
        <button id="btn-hud-perf" type="button" class="px-2 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-mono text-emerald-300 shadow cursor-pointer" title="Toggle Chromebook Perf HUD & Console (`)">
          📊 Perf
        </button>
        <button id="btn-hud-photo" type="button" class="px-2 py-1 rounded-lg bg-slate-900/85 hover:bg-slate-800 border border-white/15 text-xs font-semibold shadow cursor-pointer" title="Toggle Photo Mode">
          📸 Photo
        </button>
      </div>
      <!-- In-Game Perf HUD & Streaming Cell Telemetry (§5.16 Chromebook-First) -->
      <div id="perf-hud-overlay" class="bg-slate-950/90 border border-emerald-500/40 px-3 py-1.5 rounded-xl font-mono text-[10px] text-emerald-300 grid grid-cols-2 sm:grid-cols-4 gap-x-3 gap-y-0.5 shadow-lg">
        <div>TIER: <strong id="perf-tier" class="text-white">T2 (Auto)</strong></div>
        <div>DRS: <strong id="perf-drs" class="text-white">1.00x</strong></div>
        <div>FRAME: <strong id="perf-ms" class="text-white">16.6 ms</strong></div>
        <div>DRAW/TRIS: <strong id="perf-draws" class="text-white">42 / 18k</strong></div>
        <div>CELL (256m): <strong id="perf-cell" class="text-amber-300">C(0,0) R0</strong></div>
        <div>LRU PACKS: <strong id="perf-lru" class="text-sky-300">9 / 40</strong></div>
        <div>ENTITIES: <strong id="perf-ents" class="text-white">22V 24P</strong></div>
        <div>INPUT: <strong id="perf-input" class="text-purple-300">Chromebook+Touch</strong></div>
      </div>
    </div>

    <!-- Top-Center: Active Mission / Heist Objective Banner -->
    <div id="hud-mission-box" class="hud-interactive max-w-md bg-slate-950/85 border-l-4 border-amber-400 px-3.5 py-2 rounded-r-xl backdrop-blur-md shadow-xl">
      <div class="flex items-center justify-between gap-3">
        <span id="hud-mission-title" class="text-xs font-bold uppercase tracking-wider text-amber-400">FREE ROAM — LOS SANTOS</span>
        <button id="btn-quick-mission" type="button" class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-400 text-slate-950 hover:bg-amber-300 transition cursor-pointer">Start Mission</button>
      </div>
      <div id="hud-mission-desc" class="text-xs sm:text-sm text-slate-100 font-medium mt-0.5">Drive to golden Mission Markers or open iFruit Phone (P) to launch Story Missions & Heists.</div>
    </div>

    <!-- Top-Right: Wanted Stars, Cash, Character Badge & Vehicle Speedometer -->
    <div class="flex flex-col items-end gap-1.5 hud-interactive">
      <!-- Wanted Level Stars (1-5) -->
      <div class="flex items-center gap-2 bg-slate-950/80 border border-white/15 px-3 py-1.5 rounded-xl backdrop-blur-md">
        <div id="wanted-stars-row" class="flex items-center gap-1 text-xl leading-none">
          <span class="wanted-star text-slate-700" data-star="1">★</span>
          <span class="wanted-star text-slate-700" data-star="2">★</span>
          <span class="wanted-star text-slate-700" data-star="3">★</span>
          <span class="wanted-star text-slate-700" data-star="4">★</span>
          <span class="wanted-star text-slate-700" data-star="5">★</span>
        </div>
        <button id="btn-clear-wanted" type="button" class="hidden text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-400/30 hover:bg-sky-500/40 cursor-pointer">Bribe Cops ($1K)</button>
      </div>

      <!-- Character Money -->
      <div id="hud-cash" class="font-gta text-3xl sm:text-4xl font-bold text-emerald-400 drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)] leading-none">$450,000</div>

      <!-- Vehicle HUD (Shown when driving/flying) -->
      <div id="hud-vehicle-panel" class="hidden bg-slate-950/85 border border-amber-400/40 px-3 py-1.5 rounded-xl flex items-center gap-3">
        <div>
          <div id="hud-vehicle-name" class="text-xs font-bold text-amber-300 uppercase">Zentorno Supercar</div>
          <div class="flex items-center gap-2 text-[11px] text-slate-300">
            <span>HP: <strong id="hud-vehicle-hp" class="text-emerald-400">100%</strong></span>
            <button id="btn-toggle-siren" type="button" class="hidden px-1.5 py-0.2 rounded bg-red-500/30 text-red-200 border border-red-400/40 text-[10px] cursor-pointer">🚨 Siren (E)</button>
          </div>
        </div>
        <div class="text-right">
          <span id="hud-speed-mph" class="font-gta text-3xl font-bold text-white leading-none">0</span>
          <span class="text-[10px] text-slate-400 block -mt-1">MPH</span>
        </div>
      </div>
    </div>
  </div>

  <!-- CONTEXTUAL PROMPT (e.g., Press F to Hijack Zentorno / Press G for LS Customs) -->
  <div id="hud-context-prompt" class="self-center hidden hud-interactive bg-slate-950/90 border border-amber-400/60 px-4 py-2 rounded-full shadow-2xl flex items-center gap-2">
    <span id="hud-context-text" class="text-xs sm:text-sm font-semibold text-white">Press [F] to enter Zentorno Supercar</span>
    <button id="btn-context-action" type="button" class="px-2.5 py-1 rounded-full bg-amber-400 text-slate-950 text-xs font-bold uppercase cursor-pointer">Action (F)</button>
  </div>

  <!-- BOTTOM BAR: GTA 5 Rectangular Radar Minimap (Left), Mobile/Action Controls (Center), Character Switch Wheel (Right) -->
  <div class="w-full p-2.5 sm:p-4 flex items-end justify-between gap-2">
    <!-- Bottom-Left: Rectangular GTA 5 Radar Minimap + 3 Status Bars (Health, Armor, Special) -->
    <div class="hud-interactive flex flex-col bg-slate-950/90 border-2 border-slate-700/90 rounded-lg overflow-hidden shadow-[0_10px_30px_rgba(0,0,0,0.85)] w-48 sm:w-64">
      <div class="relative w-full h-32 sm:h-40 bg-slate-900">
        <canvas id="radar-canvas" width="256" height="160" class="w-full h-full block"></canvas>
        <div class="absolute top-1.5 left-2 text-[10px] font-bold uppercase tracking-wider text-white/80 bg-black/50 px-1.5 py-0.5 rounded">GPS RADAR</div>
        <div id="radar-wanted-flash" class="
absolute inset-0 pointer-events-none hidden bg-gradient-to-r from-red-500/25 to-blue-500/25 animate-pulse"></div>
      </div>
      <!-- GTA 5 Signature 3 Horizontal Status Bars under Minimap: Green (Health), Blue (Armor), Yellow (Special) -->
