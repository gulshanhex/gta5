  function showToast(msg) {
    const box = document.getElementById('toast-box');
    if (!box) return;
    box.textContent = msg;
    box.classList.remove('hidden');
    clearTimeout(box._timer);
    box._timer = setTimeout(() => box.classList.add('hidden'), 3200);
  }

  function addCash(amount, reason) {
    const p = PROTAGONISTS[activeCharId];
    p.cash = Math.max(0, p.cash + amount);
    const sign = amount >= 0 ? '+' : '-';
    bankTransactions.unshift({
      label: reason || 'Los Santos Activity',
      amount: sign + '$' + Math.abs(amount).toLocaleString(),
    });
    if (bankTransactions.length > 8) bankTransactions.pop();
    if (amount > 0) playSFX('cash');
    updateHUD();
  }

  // Save/Load from localStorage safely wrapped in try/catch
  function saveGameToStorage() {
    try {
      const payload = {
        activeCharId,
        protagonists: PROTAGONISTS,
        completedMissions: MISSIONS.filter(m => m.completed).map(m => m.id),
        stocks: STOCKS,
        gfxPreset,
      };
      localStorage.setItem('gta5_los_santos_save_v1', JSON.stringify(payload));
      showToast('💾 Game Saved to Browser Storage!');
    } catch (e) {
      showToast('Save stored in session memory.');
    }
  }

  function loadGameFromStorage() {
    try {
      const raw = localStorage.getItem('gta5_los_santos_save_v1');
      if (!raw) return;
      const data = JSON.parse(raw);
      if (data.protagonists) {
        for (const k of Object.keys(PROTAGONISTS)) {
          if (data.protagonists[k]) {
            PROTAGONISTS[k].cash = data.protagonists[k].cash;
          }
        }
      }
      if (Array.isArray(data.completedMissions)) {
        MISSIONS.forEach(m => {
          if (data.completedMissions.includes(m.id)) m.completed = true;
        });
      }
    } catch (e) {}
  }

