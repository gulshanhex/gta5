      audioCtx.resume().catch(() => {});
    }
  }

  function playTone(freq, duration, type = 'sawtooth', vol = 0.06) {
    if (soundMuted || !audioCtx) return;
    try {
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(vol, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch (e) {}
  }

  function playSFX(kind) {
    ensureAudio();
    if (soundMuted || !audioCtx) return;
    if (kind === 'shoot') {
      playTone(150, 0.09, 'sawtooth', 0.11);
      playTone(85, 0.12, 'square', 0.09);
    } else if (kind === 'explosion') {
      playTone(55, 0.45, 'sawtooth', 0.22);
      playTone(38, 0.55, 'triangle', 0.20);
    } else if (kind === 'switch') {
      playTone(440, 0.14, 'sine', 0.09);
      setTimeout(() => playTone(660, 0.18, 'sine', 0.09), 110);
    } else if (kind === 'cash') {
      playTone(587.3, 0.1, 'triangle', 0.1);
      setTimeout(() => playTone(880, 0.2, 'triangle', 0.12), 90);
    } else if (kind === 'siren') {
      playTone(680, 0.18, 'sine', 0.04);
    }
  }

  let radioStep = 0;
  function updateRadioStation(index) {
    currentRadioIndex = index;
    if (radioInterval) {
      clearInterval(radioInterval);
      radioInterval = null;
    }
    const st = RADIO_STATIONS[currentRadioIndex] || RADIO_STATIONS[0];
