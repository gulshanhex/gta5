<script is:inline>
(function() {
  // Embedded base64 fallbacks for pure binary .glb 3D assets & procedural textures
  const EMBEDDED_GLB_B64 = {"/models/character_franklin.glb": "", "/models/character_michael.glb": "", "/models/character_trevor.glb": "", "/models/city_landmarks.glb": "", "/models/vehicle_helicopter.glb": "", "/models/vehicle_motorcycle.glb": "", "/models/vehicle_muscle.glb": "", "/models/vehicle_police.glb": "", "/models/vehicle_sportscar.glb": "", "/models/weapon_pack.glb": ""};
  const EMBEDDED_TEX_B64 = {"/textures/building_facade.png": "data:image/png;base64,", "/textures/los_santos_hero.jpg": "data:image/jpeg;base64,", "/textures/road_asphalt.png": "data:image/png;base64,", "/textures/terrain_grass.png": "data:image/png;base64,"};

  // ============================================================================
  // 1. PURE BINARY glTF 2.0 (.GLB) PARSER FOR THREE.JS
  // ============================================================================
  const parsedGLBCache = {};

  function base64ToArrayBuffer(b64) {
    const bin = atob(b64);
    const len = bin.length;
    const bytes = new Uint8Array(len);
    for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }

  function parseGLBBufferToMesh(arrayBuffer) {
    const dv = new DataView(arrayBuffer);
    const magic = dv.getUint32(0, true);
    if (magic !== 0x46546C67) throw new Error('Invalid GLB magic header');
    const jsonLen = dv.getUint32(12, true);
    const jsonBytes = new Uint8Array(arrayBuffer, 20, jsonLen);
    const gltf = JSON.parse(new TextDecoder().decode(jsonBytes));

    const binHeaderOffset = 20 + jsonLen;
    const binLen = dv.getUint32(binHeaderOffset, true);
    const binByteOffset = binHeaderOffset + 8;

    const prim = gltf.meshes[0].primitives[0];
    const posAcc = gltf.accessors[prim.attributes.POSITION];
    const normAcc = gltf.accessors[prim.attributes.NORMAL];
    const colAcc = gltf.accessors[prim.attributes.COLOR_0];
    const idxAcc = gltf.accessors[prim.indices];

    const posBV = gltf.bufferViews[posAcc.bufferView];
    const normBV = gltf.bufferViews[normAcc.bufferView];
    const colBV = gltf.bufferViews[colAcc.bufferView];
    const idxBV = gltf.bufferViews[idxAcc.bufferView];

    const positions = new Float32Array(arrayBuffer, binByteOffset + (posBV.byteOffset || 0), posAcc.count * 3);
    const normals = new Float32Array(arrayBuffer, binByteOffset + (normBV.byteOffset || 0), normAcc.count * 3);
    const colors = new Float32Array(arrayBuffer, binByteOffset + (colBV.byteOffset || 0), colAcc.count * 3);
    const indices = new Uint16Array(arrayBuffer, binByteOffset + (idxBV.byteOffset || 0), idxAcc.count);

    const geom = new THREE.BufferGeometry();
    geom.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));
    geom.setAttribute('normal', new THREE.BufferAttribute(new Float32Array(normals), 3));
    geom.setAttribute('color', new THREE.BufferAttribute(new Float32Array(colors), 3));
    geom.setIndex(new THREE.BufferAttribute(new Uint16Array(indices), 1));
    geom.computeBoundingSphere();

    const matDef = (gltf.materials && gltf.materials[0] && gltf.materials[0].pbrMetallicRoughness) || {};
    const mat = new THREE.MeshStandardMaterial({
      vertexColors: true,
      roughness: matDef.roughnessFactor !== undefined ? matDef.roughnessFactor : 0.45,
      metalness: matDef.metallicFactor !== undefined ? matDef.metallicFactor : 0.35,
    });
    const mesh = new THREE.Mesh(geom, mat);
    mesh.name = (gltf.nodes && gltf.nodes[0] && gltf.nodes[0].name) || 'GLBAsset';
    return mesh;
  }

  async function loadAllGLBModels() {
    const modelPaths = Object.keys(EMBEDDED_GLB_B64);
    for (const path of modelPaths) {
      try {
        // First try embedded binary .glb buffer (instant & works in both Cloudflare Workers and Canvas)
        if (EMBEDDED_GLB_B64[path]) {
          const buf = base64ToArrayBuffer(EMBEDDED_GLB_B64[path]);
          parsedGLBCache[path] = parseGLBBufferToMesh(buf);
          continue;
        }
        const res = await fetch(path);
        if (res.ok) {
          const buf = await res.arrayBuffer();
          parsedGLBCache[path] = parseGLBBufferToMesh(buf);
        }
      } catch (e) {
        console.warn('Fallback for GLB:', path, e);
      }
    }
  }

  function cloneGLBMesh(path, tintHex) {
    const template = parsedGLBCache[path];
    if (!template) {
      const fallback = new THREE.Mesh(
        new THREE.BoxGeometry(1.5, 1.5, 3),
        new THREE.MeshStandardMaterial({ color: tintHex || 0xffffff })
      );
      return fallback;
    }
    const clone = new THREE.Mesh(template.geometry, template.material.clone());
    if (tintHex) {
      clone.material.color.set(tintHex);
    }
    const group = new THREE.Group();
    group.add(clone);
    return group;
  }

