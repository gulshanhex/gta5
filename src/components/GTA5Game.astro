    { id: 'wcc', name: 'West Coast Classics', genre: 'G-Funk Lowrider Synth', tempo: 280, notes: [130.8, 164.8, 196.0, 261.6, 523.2, 392.0, 261.6, 196.0] },
    { id: 'flylo', name: 'FlyLo FM', genre: 'Electronic Midnight Bass', tempo: 185, notes: [146.8, 220.0, 293.7, 369.9, 440.0, 293.7, 220.0, 185.0] }
