  function createVehicleEntity(type, x, z, rotY = 0, customHex = null) {
    let glbPath = '/models/vehicle_sportscar.glb';
    let name = 'Zentorno Supercar';
    let maxSpeed = 46;
    let accel = 28;
    let isHeli = false;
    let isPolice = false;
    let isBoat = false;
    let isPlane = false;

    if (type === 'muscle') {
      glbPath = '/models/vehicle_muscle.glb';
      name = 'Sabre Turbo Muscle';
      maxSpeed = 39;
      accel = 24;
    } else if (type === 'police') {
      glbPath = '/models/vehicle_police.glb';
      name = 'Police Interceptor';
      maxSpeed = 43;
      accel = 26;
      isPolice = true;
    } else if (type === 'swat') {
      glbPath = '/models/vehicle_police.glb';
      name = 'NOOSE Tactical SWAT SUV';
      maxSpeed = 41;
      accel = 27;
      isPolice = true;
      customHex = customHex || '#1e293b';
    } else if (type === 'helicopter') {
      glbPath = '/models/vehicle_helicopter.glb';
      name = 'Buzzard Attack Chopper';
      maxSpeed = 54;
      accel = 30;
      isHeli = true;
    } else if (type === 'plane') {
      glbPath = '/models/vehicle_helicopter.glb';
      name = 'Velum Stunt Plane';
      maxSpeed = 68;
      accel = 36;
      isHeli = true;
      isPlane = true;
      customHex = customHex || '#38bdf8';
    } else if (type === 'boat') {
      glbPath = '/models/vehicle_sportscar.glb';
      name = 'Speedophile Jet-Boat';
      maxSpeed = 50;
      accel = 30;
      isBoat = true;
      customHex = customHex || '#0ea5e9';
    } else if (type === 'motorcycle') {
      glbPath = '/models/vehicle_motorcycle.glb';
      name = 'PCJ-600 Sportbike';
      maxSpeed = 44;
      accel = 32;
    }

    const mesh = cloneGLBMesh(glbPath, customHex);
    // Attach §6.5 Vehicle Node Contract hierarchy (wheel_fl, wheel_fr, wheel_rl, wheel_rr, rotor_main, headlights)
    const wheelNodes = [];
    if (!isHeli && !isBoat) {
      const wGeom = new THREE.CylinderGeometry(0.38, 0.38, 0.28, 12);
      wGeom.rotateZ(Math.PI / 2);
      const wMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.7 });
      const offsets = type === 'motorcycle'
        ? [[0, 0.38, 1.05], [0, 0.38, -1.05]]
        : [[-0.85, 0.38, 1.2], [0.85, 0.38, 1.2], [-0.85, 0.38, -1.2], [0.85, 0.38, -1.2]];
      offsets.forEach((off, idx) => {
        const wMesh = new THREE.Mesh(wGeom, wMat);
        wMesh.position.set(off[0], off[1], off[2]);
        wMesh.name = ['wheel_fl', 'wheel_fr', 'wheel_rl', 'wheel_rr'][idx] || 'wheel';
        mesh.add(wMesh);
        wheelNodes.push(wMesh);
      });
    }
    let rotorNode = null;
    if (isHeli) {
      rotorNode = new THREE.Mesh(
        new THREE.BoxGeometry(isPlane ? 2.2 : 7.5, 0.08, 0.35),
        new THREE.MeshBasicMaterial({ color: 0x94a3b8 })
      );
      rotorNode.position.set(0, isPlane ? 0.9 : 2.15, isPlane ? 2.1 : 0);
      rotorNode.name = 'rotor_main';
      mesh.add(rotorNode);
    }
    // Headlight beam cones
    const headLights = new THREE.Group();
    const hlCone = new THREE.ConeGeometry(1.4, 8, 12, 1, true);
    hlCone.rotateX(Math.PI / 2);
    const hlMat = new THREE.MeshBasicMaterial({ color: 0xfef08a, transparent: true, opacity: 0.18, side: THREE.DoubleSide });
    const hlL = new THREE.Mesh(hlCone, hlMat);
    hlL.position.set(-0.6, 0.65, 5.2);
    const hlR = new THREE.Mesh(hlCone, hlMat);
    hlR.position.set(0.6, 0.65, 5.2);
    headLights.add(hlL, hlR);
    mesh.add(headLights);

    mesh.position.set(x, 0, z);
    mesh.rotation.y = rotY;
    scene.add(mesh);

    const veh = {
      type,
      name,
      mesh,
      speed: 0,
      maxSpeed,
      accel,
      hp: 100,
      isHeli,
      isPolice,
      sirenOn: isPolice,
      isTraffic: false,
      neonLight: null,
      wheelNodes,
      rotorNode,
      headLights,
      lightsOn: true,
      isBoat,
      isPlane,
    };
    vehicles.push(veh);
    return veh;
  }

