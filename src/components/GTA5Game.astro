  function createProceduralTexture(dataUri, repeatX = 1, repeatY = 1) {
    const tex = new THREE.TextureLoader().load(dataUri);
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(repeatX, repeatY);
    return tex;
  }

  async function initThreeEngine() {
    await loadAllGLBModels();

    const container = document.getElementById('webgl-container');
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x1e293b);
    scene.fog = new THREE.FogExp2(0x1e293b, 0.0032);

    camera = new THREE.PerspectiveCamera(62, window.innerWidth / window.innerHeight, 0.5, 550);

    renderer = new THREE.WebGLRenderer({ antialias: gfxPreset === 'high', powerPreference: 'high-performance' });
    renderer.setSize(window.innerWidth, window.innerHeight);
    applyGraphicsPreset(gfxPreset);
    container.innerHTML = '';
    container.appendChild(renderer.domElement);

    // Lighting
    ambientLight = new THREE.AmbientLight(0xffffff, 0.65);
    scene.add(ambientLight);

    hemiLight = new THREE.HemisphereLight(0xfde68a, 0x1e293b, 0.55);
    scene.add(hemiLight);

    sunLight = new THREE.DirectionalLight(0xfffbeb, 1.15);
    sunLight.position.set(120, 180, 90);
    scene.add(sunLight);

    buildLosSantosWorld();
    spawnProtagonistMeshes();
    spawnInitialVehicles();
    spawnInitialPedestrians();
    updateHUD();
    renderPhoneMissions();
    renderPhoneStocks();
    renderWeaponWheel();
    renderRadioWheel();

    window.addEventListener('resize', () => {
      if (!camera || !renderer) return;
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }

  function applyGraphicsPreset(preset) {
    gfxPreset = preset;
    if (!renderer || !scene) return;
    if (preset === 'low') {
      renderer.setPixelRatio(0.65);
      scene.fog = new THREE.FogExp2(0x1e293b, 0.0055);
      camera.far = 240;
    } else if (preset === 'balanced') {
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.15));
      scene.fog = new THREE.FogExp2(0x1e293b, 0.0032);
      camera.far = 380;
    } else {
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
      scene.fog = new THREE.FogExp2(0x1e293b, 0.0020);
      camera.far = 550;
    }
    camera.updateProjectionMatrix();
    document.querySelectorAll('.gfx-preset-btn').forEach(btn => {
      const active = btn.getAttribute('data-gfx-preset') === preset;
      btn.classList.toggle('border-emerald-400', active);
      btn.classList.toggle('bg-emerald-500/20', active);
    });
  }

