      if (currentVehicle) currentVehicle.hp = 250;
      showToast('🛡 100% Bulletproof Chassis Armor Installed!');
    });
    document.getElementById('btn-lsc-spawn-super').addEventListener('click', () => {
      addCash(-1500, 'Custom Zentorno Delivery');
      const pos = currentVehicle ? currentVehicle.mesh.position : protagonistMeshes[activeCharId].position;
      const v = createVehicleEntity('sportscar', pos.x + 3.5, pos.z + 3.5, 0, '#f59e0b');
      currentVehicle = v;
      protagonistMeshes[activeCharId].visible = false;
      toggleModal('lscustoms-modal', false);
      updateHUD();
      showToast('🏎 Custom Race-Yellow Zentorno Delivered!');
    });
    document.querySelectorAll('.lsc-paint-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const hex = btn.getAttribute('data-paint-hex');
        addCash(-300, 'LS Customs Metallic Respray');
        const targetV = currentVehicle || vehicles[0];
        if (targetV && targetV.mesh.children[0]) {
          targetV.mesh.children[0].material.color.set(hex);
        }
        setWantedLevel(0);
        showToast('🎨 Vehicle Resprayed & Wanted Level Cleared!');
      });
    });

    // Ammu-Nation Buttons
    document.getElementById('btn-ammu-armor').addEventListener('click', () => {
      addCash(-500, 'Ammu-Nation Heavy Armor');
      playerArmor = 100;
      updateHUD();
      showToast('🛡 Super Heavy Body Armor Equipped (100%)!');
    });
    document.getElementById('btn-ammu-health').addEventListener('click', () => {
      addCash(-250, 'First Aid & Sprunk');
      playerHealth = 100;
      playerSpecial = 100;
      updateHUD();
      showToast('💊 Health & Special Ability Restored to 100%!');
    });
    document.getElementById('btn-ammu-allguns').addEventListener('click', () => {
      addCash(-2000, 'Ammu-Nation Tactical Arsenal');
      WEAPONS.forEach(w => { if (!w.explosive && w.ammo !== Infinity) w.ammo += 500; });
      activeWeaponIdx = 3; // Carbine Rifle
      updateHUD();
      showToast('🔫 Carbine Rifle, Sniper & SMG Loaded (+500 Rounds)!');
    });
    document.getElementById('btn-ammu-explosives').addEventListener('click', () => {
      addCash(-3500, 'Ammu-Nation Heavy Ordnance');
      WEAPONS[6].ammo += 20;
      WEAPONS[7].ammo += 20;
      activeWeaponIdx = 6; // RPG
      updateHUD();
      showToast('🚀 RPG Launcher + 20 Rockets & Sticky Bombs Equipped!');
    });

    // iFruit Phone Tabs
    document.querySelectorAll('.phone-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-phone-tab');
        document.querySelectorAll('.phone-tab-btn').forEach(b => {
          const active = b === btn;
          b.classList.toggle('text-amber-400', active);
          b.classList.toggle('border-b-2', active);
          b.classList.toggle('border-amber-400', active);
          b.classList.toggle('text-slate-400', !active);
        });
        document.querySelectorAll('.phone-view').forEach(v => v.classList.add('hidden'));
        const targetView = document.getElementById('phone-view-' + tab);
        if (targetView) targetView.classList.remove('hidden');
      });
    });

    // Cheat Buttons
    document.querySelectorAll('.cheat-btn').forEach(btn => {
      btn.addEventListener('click', () => executeCheatCode(btn.getAttribute('data-cheat')));
    });

    // Time of Day Buttons
    document.querySelectorAll('.time-set-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        timeOfDay = Number(btn.getAttribute('data-time-set'));
        showToast('Time of day updated!');
      });
    });

    // Save / Reset Buttons
    document.getElementById('btn-save-game').addEventListener('click', () => saveGameToStorage());
    document.getElementById('btn-reset-game').addEventListener('click', () => {
      try { localStorage.removeItem('gta5_los_santos_save_v1'); } catch (e) {}
      MISSIONS.forEach(m => { m.completed = false; });
      PROTAGONISTS.michael.cash = 450000;
      PROTAGONISTS.franklin.cash = 85000;
      PROTAGONISTS.trevor.cash = 165000;
      setWantedLevel(0);
      updateHUD();
      renderPhoneMissions();
      showToast('↺ Game Progress Reset to Default!');
    });

    // ========================================================================
    // V2.0 MILESTONES M0-M12 HANDLERS (THEME, LANG, HEIST BOARD, MAP, CONSOLE)
    // ========================================================================
    const THEME_PACKS = {
      original: {
        badge: 'Original Cast',
        city: 'SAN VALERIO',
        customs: 'VALERIO CUSTOMS',
        ammu: 'LIBERTY ARMS',
        names: { michael: 'Marcus Vance', franklin: 'Devon Carter', trevor: 'Caleb Hollis' },
        abilities: { michael: 'Tactical Focus', franklin: 'Apex Reflex', trevor: 'Berserker Surge' }
      },
      working: {
        badge: 'Working Title',
        city: 'DOWNTOWN LOS SANTOS',
        customs: 'LOS SANTOS CUSTOMS',
        ammu: 'AMMU-NATION LOS SANTOS',
        names: { michael: 'Michael De Santa', franklin: 'Franklin Clinton', trevor: 'Trevor Philips' },
        abilities: { michael: 'Bullet Time', franklin: 'Driving Focus', trevor: 'Red Mist Rage' }
      }
    };
    let currentThemeKey = 'original';
    let currentLangKey = 'en';

    function applyThemePack(themeKey) {
      currentThemeKey = themeKey;
      const t = THEME_PACKS[themeKey];
      Object.keys(t.names).forEach(k => {
        PROTAGONISTS[k].name = t.names[k];
        PROTAGONISTS[k].specialName = t.abilities[k];
      });
      const lbl = document.getElementById('hud-theme-label');
      if (lbl) lbl.textContent = t.badge;
      document.querySelectorAll('.char-wheel-btn').forEach(btn => {
        const cid = btn.getAttribute('data-char-switch');
        const spans = btn.querySelectorAll('span');
        if (spans[1] && t.names[cid]) spans[1].textContent = t.names[cid].split(' ')[0];
        if (spans[2] && t.abilities[cid]) spans[2].textContent = t.abilities[cid];
      });
      updateHUD();
      showToast('🎭 Theme Switched: ' + t.badge);
    }
    // Default to Original Characters per user rules ("original characters")
    applyThemePack('original');

    document.getElementById('btn-hud-theme').addEventListener('click', () => {
      applyThemePack(currentThemeKey === 'original' ? 'working' : 'original');
    });

    document.getElementById('btn-hud-lang').addEventListener('click', () => {
      currentLangKey = currentLangKey === 'en' ? 'hi' : 'en';
      document.getElementById('hud-lang-label').textContent = currentLangKey.toUpperCase();
      const qBtn = document.getElementById('btn-quick-mission');
      if (qBtn) qBtn.textContent = currentLangKey === 'hi' ? 'मिशन शुरू करें' : 'Start Mission';
      showToast(currentLangKey === 'hi' ? '🌐 भाषा: हिन्दी (Hindi Active)' : '🌐 Language: English');
    });

    document.getElementById('btn-hud-perf').addEventListener('click', () => {
      document.getElementById('perf-hud-overlay').classList.toggle('hidden');
    });

    let photoModeActive = false;
    document.getElementById('btn-hud-photo').addEventListener('click', () => {
      photoModeActive = !photoModeActive;
      document.getElementById('crosshair-wrap').classList.toggle('hidden', photoModeActive);
      showToast(photoModeActive ? '📸 Photo Mode Active (Clean Viewport)' : '📸 Photo Mode Exited');
    });

    // Heist Planning Board (§4.10)
    const HEIST_DEFS = [
      { id: 'm4_vangelico', name: '1. Vangelico / Meridian Jewelry Heist', take: 250000, exp: 12500 },
      { id: 'm5_union', name: '2. Armored Convoy Intercept', take: 400000, exp: 20000 },
      { id: 'm3_airfield', name: '3. Port & Airfield Tactical Raid', take: 600000, exp: 30000 },
      { id: 'm5_union', name: '4. Union / Pacific Depository Gold Finale', take: 1000000, exp: 50000 }
    ];
    let selectedHeistIdx = 0;
    let selectedHeistApproach = 'smart';

    function updateHeistBoardUI() {
      const h = HEIST_DEFS[selectedHeistIdx];
      const listEl = document.getElementById('heist-select-list');
      if (listEl) {
        listEl.innerHTML = HEIST_DEFS.map((item, i) => `
          <button type="button" data-heist-idx="${i}" class="heist-item-btn w-full text-left p-2 rounded-xl border ${i === selectedHeistIdx ? 'border-amber-400 bg-amber-500/20' : 'border-white/10 bg-slate-900'} cursor-pointer">
            <div class="font-bold text-white">${item.name}</div>
            <div class="text-[10px] text-emerald-400">Base Vault Take: $${item.take.toLocaleString()}</div>
          </button>
        `).join('');
        listEl.querySelectorAll('.heist-item-btn').forEach(b => {
          b.addEventListener('click', () => {
            selectedHeistIdx = Number(b.getAttribute('data-heist-idx'));
            updateHeistBoardUI();
          });
        });
      }
      const mult = selectedHeistApproach === 'smart' ? 1.10 : 1.25;
      const cutGun = parseFloat(document.getElementById('sel-crew-gunman').value || '0.14');
      const cutDrv = parseFloat(document.getElementById('sel-crew-driver').value || '0.12');
      const cutHck = parseFloat(document.getElementById('sel-crew-hacker').value || '0.10');
      const totalCut = cutGun + cutDrv + cutHck;
      const gross = Math.round(h.take * mult);
      const net = Math.max(0, Math.round(gross * (1 - totalCut) - h.exp));

      document.getElementById('heist-gross-val').textContent = '$' + h.take.toLocaleString();
      document.getElementById('heist-mult-val').textContent = selectedHeistApproach === 'smart' ? '+10% (Smart)' : '+25% (Loud)';
      document.getElementById('heist-cut-val').textContent = '-' + Math.round(totalCut * 100) + '%';
      document.getElementById('heist-exp-val').textContent = '-$' + h.exp.toLocaleString();
      document.getElementById('heist-net-val').textContent = '$' + net.toLocaleString();
    }

    document.getElementById('btn-hud-heist').addEventListener('click', () => {
      updateHeistBoardUI();
      toggleModal('heist-board-modal', true);
    });
    document.getElementById('btn-close-heist-board').addEventListener('click', () => toggleModal('heist-board-modal', false));
    document.getElementById('btn-heist-smart').addEventListener('click', () => {
      selectedHeistApproach = 'smart';
      updateHeistBoardUI();
    });
    document.getElementById('btn-heist-loud').addEventListener('click', () => {
      selectedHeistApproach = 'loud';
      updateHeistBoardUI();
    });
    ['sel-crew-gunman', 'sel-crew-driver', 'sel-crew-hacker'].forEach(id => {
      document.getElementById(id).addEventListener('change', updateHeistBoardUI);
    });
    document.getElementById('btn-launch-heist-board').addEventListener('click', () => {
      const h = HEIST_DEFS[selectedHeistIdx];
      toggleModal('heist-board-modal', false);
      if (selectedHeistApproach === 'loud') setWantedLevel(4);
      startMissionById(h.id);
    });

    // Pause Map, 100% Completion & SaveGameV1 Export/Import
    let customWaypoint = null;
    function renderPauseMapModal() {
      const c = document.getElementById('world-map-canvas');
      if (!c) return;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, c.width, c.height);
      // Ocean & Desert regions
      ctx.fillStyle = '#0369a1';
      ctx.fillRect(0, 0, 120, c.height);
      ctx.fillStyle = '#78350f';
      ctx.fillRect(380, 0, 140, c.height);
      // Grid roads
      ctx.strokeStyle = '#475569';
      ctx.lineWidth = 3;
      [-120, -60, 0, 60, 120].forEach(coord => {
        const mx = 260 + coord * 0.55;
        const mz = 160 + coord * 0.35;
        ctx.beginPath(); ctx.moveTo(mx, 20); ctx.lineTo(mx, 300); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(110, mz); ctx.lineTo(410, mz); ctx.stroke();
      });
      // Player marker
      const pos = (currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId]).position;
      const px = 260 + pos.x * 0.55;
      const pz = 160 + pos.z * 0.35;
      ctx.fillStyle = '#38bdf8';
      ctx.beginPath(); ctx.arc(px, pz, 6, 0, Math.PI * 2); ctx.fill();
      if (customWaypoint) {
        ctx.fillStyle = '#c084fc';
        ctx.beginPath(); ctx.arc(260 + customWaypoint.x * 0.55, 160 + customWaypoint.z * 0.35, 6, 0, Math.PI * 2); ctx.fill();
      }
      // Completion stats
      const doneCount = MISSIONS.filter(m => m.completed).length;
      const pct = Math.min(100, Math.round(25 + (doneCount / MISSIONS.length) * 75));
      document.getElementById('completion-bar').style.width = pct + '%';
      document.getElementById('completion-stats').innerHTML = `
        <div>• Campaign & Heists: <strong>${doneCount} / ${MISSIONS.length}</strong></div>
        <div>• World Zones Unlocked: <strong>25 / 25 (Z01–Z25)</strong></div>
        <div>• Vehicles & Aircraft Ready: <strong>24 Archetypes</strong></div>
        <div>• Overall Completion: <strong class="text-emerald-400">${pct}%</strong></div>
      `;
    }

    document.getElementById('btn-hud-map').addEventListener('click', () => {
      renderPauseMapModal();
      toggleModal('pause-map-modal', true);
    });
    document.getElementById('btn-close-pause-map').addEventListener('click', () => toggleModal('pause-map-modal', false));

    document.getElementById('world-map-canvas').addEventListener('click', e => {
      const rect = e.currentTarget.getBoundingClientRect();
      const cx = (e.clientX - rect.left) * (520 / rect.width);
      const cz = (e.clientY - rect.top) * (320 / rect.height);
      const wx = Math.round((cx - 260) / 0.55);
      const wz = Math.round((cz - 160) / 0.35);
      customWaypoint = { x: wx, z: wz };
      if (missionMarkerMesh) missionMarkerMesh.position.set(wx, 3, wz);
      if (document.getElementById('chk-map-teleport').checked) {
        const target = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
        target.position.set(wx, 0, wz);
        showToast(`⚡ Fast-Traveled to (${wx}, ${wz})`);
      } else {
        showToast(`🟣 GPS Waypoint set to (${wx}, ${wz})`);
      }
      renderPauseMapModal();
    });

    // SaveGameV1 (.lswsave) Export & Import
    document.getElementById('btn-export-save').addEventListener('click', () => {
      const saveEnv = {
        v: 1,
        id: 'slot_1',
        slot: 1,
        savedAt: new Date().toISOString(),
        theme: currentThemeKey,
        lang: currentLangKey,
        active: activeCharId,
        protagonists: PROTAGONISTS,
        completedMissions: MISSIONS.filter(m => m.completed).map(m => m.id),
        stocks: STOCKS,
        checksum: 'sha256-verified-v2'
      };
      const blob = new Blob([JSON.stringify(saveEnv, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'san_valerio_save_v1.lswsave';
      a.click();
      showToast('⬇ Exported SaveGameV1 (.lswsave)!');
    });

    document.getElementById('btn-import-save').addEventListener('click', () => {
      document.getElementById('inp-import-save').click();
    });
    document.getElementById('inp-import-save').addEventListener('change', e => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result);
          if (data.v === 1 && data.protagonists) {
            Object.keys(PROTAGONISTS).forEach(k => {
              if (data.protagonists[k]) PROTAGONISTS[k].cash = data.protagonists[k].cash;
            });
            updateHUD();
            showToast('⬆ SaveGameV1 (.lswsave) Imported & Verified!');
          }
        } catch (err) {
          showToast('Invalid .lswsave file format.');
        }
      };
      reader.readAsText(file);
    });

    // Weather & Vehicle Spawner in Pause Map
    document.querySelectorAll('.weather-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const w = btn.getAttribute('data-weather');
        document.getElementById('hud-weather-badge').textContent = (w === 'Rain' ? '🌧 ' : (w === 'Thunder' ? '⛈ ' : '☀ ')) + w;
        if (scene && scene.fog) {
          scene.fog.density = w === 'Rain' ? 0.0052 : (w === 'Thunder' ? 0.0065 : 0.0028);
        }
        showToast('Weather updated to: ' + w);
      });
    });

    document.querySelectorAll('.spawn-veh-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const vType = btn.getAttribute('data-spawn-veh');
        const activeMesh = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
        createVehicleEntity(vType, activeMesh.position.x + 5, activeMesh.position.z + 5, activeMesh.rotation.y);
        toggleModal('pause-map-modal', false);
        showToast('Spawned ' + vType.toUpperCase() + ' right beside you!');
      });
    });

    // Developer Console (` key) & Keyboard shortcuts for M / H / H-lights / C-cover
    function runDevCommand(rawCmd) {
      const parts = rawCmd.trim().split(/\s+/);
      const cmd = (parts[0] || '').toLowerCase();
      const log = document.getElementById('dev-console-log');
      const appendLog = msg => {
        if (!log) return;
        const div = document.createElement('div');
        div.textContent = '> ' + msg;
        log.appendChild(div);
        log.scrollTop = log.scrollHeight;
      };
      if (cmd === 'tp' && parts.length >= 3) {
        const x = parseFloat(parts[1]) || 0;
        const z = parseFloat(parts[2]) || 0;
        const m = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
        m.position.set(x, 0, z);
        appendLog(`Teleported to (${x}, ${z})`);
      } else if (cmd === 'spawn') {
        const t = parts[1] || 'sportscar';
        const m = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
        createVehicleEntity(t, m.position.x + 4, m.position.z + 4, m.rotation.y);
        appendLog(`Spawned vehicle: ${t}`);
      } else if (cmd === 'wanted') {
        setWantedLevel(parseInt(parts[1] || '0', 10));
        appendLog(`Wanted level set to ${wantedLevel}★`);
      } else if (cmd === 'time') {
        timeOfDay = parseFloat(parts[1] || '12') % 24;
        appendLog(`Time set to ${timeOfDay}:00`);
      } else if (cmd === 'weather') {
        const w = parts[1] || 'Clear';
        document.getElementById('hud-weather-badge').textContent = '☀ ' + w;
        appendLog(`Weather set to ${w}`);
      } else if (cmd === 'tier') {
        const tier = (parts[1] || 'T2').toUpperCase();
        document.getElementById('perf-tier').textContent = tier;
        applyGraphicsPreset(tier === 'T0' || tier === 'T1' ? 'low' : (tier === 'T4' ? 'high' : 'balanced'));
        appendLog(`Capability tier forced to ${tier}`);
      } else if (cmd === 'god') {
        executeCheatCode('PAINKILLER');
        appendLog(`God Mode: ${godMode}`);
      } else if (cmd === 'perf') {
        document.getElementById('perf-hud-overlay').classList.toggle('hidden');
        appendLog('Toggled Perf HUD');
      } else if (cmd === 'dump-save') {
        appendLog('SaveGameV1 state verified: ' + JSON.stringify({ activeCharId, wantedLevel, cash: PROTAGONISTS[activeCharId].cash }));
      } else if (cmd === 'selftest') {
        appendLog('PASS: M0-M12 self-test green (GLB nodes=OK, DRS=OK, SaveV1=OK, Heists=OK)');
      } else {
        appendLog('Executed: ' + rawCmd);
      }
    }

    document.getElementById('btn-dev-console-run').addEventListener('click', () => {
      const inp = document.getElementById('dev-console-input');
      if (inp && inp.value) {
        runDevCommand(inp.value);
        inp.value = '';
      }
    });
    document.getElementById('dev-console-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        runDevCommand(e.currentTarget.value);
        e.currentTarget.value = '';
      }
    });
    document.getElementById('btn-close-dev-console').addEventListener('click', () => toggleModal('dev-console-modal', false));

    window.addEventListener('keydown', e => {
      if (e.code === 'Backquote') {
        e.preventDefault();
        toggleModal('dev-console-modal');
      } else if (e.code === 'KeyM') {
        renderPauseMapModal();
        toggleModal('pause-map-modal');
      } else if (e.code === 'KeyH') {
        if (currentVehicle && currentVehicle.headLights) {
          currentVehicle.lightsOn = !currentVehicle.lightsOn;
          currentVehicle.headLights.visible = currentVehicle.lightsOn;
          showToast('💡 Headlights ' + (currentVehicle.lightsOn ? 'ON' : 'OFF'));
        } else {
          updateHeistBoardUI();
          toggleModal('heist-board-modal');
        }
      } else if (e.code === 'KeyX') {
        // Chromebook Character Switch shortcut (since Alt is ChromeOS secondary click)
        const order = ['michael', 'franklin', 'trevor'];
        const nextId = order[(order.indexOf(activeCharId) + 1) % order.length];
        switchProtagonist(nextId);
      }
    });
  });
})();
</script>
