    document.getElementById('btn-hud-radio').addEventListener('click', () => toggleModal('radio-wheel-modal'));
    document.getElementById('btn-close-radio-wheel').addEventListener('click', () => toggleModal('radio-wheel-modal', false));
    document.getElementById('btn-hud-lscustoms').addEventListener('click', () => toggleModal('lscustoms-modal'));
    document.getElementById('btn-close-lscustoms').addEventListener('click', () => toggleModal('lscustoms-modal', false));
    document.getElementById('btn-hud-ammunation').addEventListener('click', () => toggleModal('ammunation-modal'));
    document.getElementById('btn-close-ammunation').addEventListener('click', () => toggleModal('ammunation-modal', false));

