  function spawnInitialPedestrians() {
    const pedModels = ['/models/character_michael.glb', '/models/character_franklin.glb', '/models/character_trevor.glb'];
    for (let i = 0; i < 24; i++) {
      const m = cloneGLBMesh(pedModels[i % pedModels.length]);
      const px = -110 + ((i * 29) % 220);
      const pz = -110 + ((i * 43) % 220);
      m.position.set(px, 0, pz);
      m.rotation.y = (i * 1.1) % (Math.PI * 2);
      scene.add(m);
      pedestrians.push({
        mesh: m,
        hp: 40,
        dir: m.rotation.y,
        speed: 2.2 + (i % 3) * 0.4,
        hostile: false,
        isMissionTarget: false,
      });
    }
  }

  // ============================================================================
  // 5. CHARACTER SWITCHING (SKY-CAM TRANSITION) & SPECIAL ABILITIES
  // ============================================================================
  let skyCamActive = false;

  function switchProtagonist(targetId) {
    if (!PROTAGONISTS[targetId] || targetId === activeCharId || skyCamActive) return;

    // Exit current vehicle cleanly before switching
    if (currentVehicle) {
      currentVehicle = null;
      protagonistMeshes[activeCharId].visible = true;
    }

    skyCamActive = true;
    playSFX('switch');

    const banner = document.getElementById('skycam-banner');
    const bannerTxt = document.getElementById('skycam-text');
    if (banner && bannerTxt) {
      bannerTxt.textContent = 'SAT-CAM: SWITCHING TO ' + PROTAGONISTS[targetId].name.toUpperCase() + '...';
      banner.classList.remove('hidden');
    }

    const fromMesh = protagonistMeshes[activeCharId];
    const toMesh = protagonistMeshes[targetId];
    const startPos = fromMesh.position.clone();
    const endPos = toMesh.position.clone();

    let step = 0;
    const skyTimer = setInterval(() => {
      step++;
      if (step === 1) {
        camera.position.set(startPos.x, 65, startPos.z + 25);
        camera.lookAt(startPos);
        playSFX('switch');
      } else if (step === 2) {
        camera.position.set((startPos.x + endPos.x) * 0.5, 145, (startPos.z + endPos.z) * 0.5 + 30);
        camera.lookAt(endPos);
      } else if (step === 3) {
        camera.position.set(endPos.x, 55, endPos.z + 22);
        camera.lookAt(endPos);
        playSFX('switch');
      } else {
        clearInterval(skyTimer);
        activeCharId = targetId;
        skyCamActive = false;
        if (banner) banner.classList.add('hidden');
        showToast('Switched to ' + PROTAGONISTS[targetId].name + ' (' + PROTAGONISTS[targetId].specialName + ')');
        updateHUD();
      }
    }, 340);
  }

  function toggleSpecialAbility() {
    if (playerSpecial < 15 && !specialActive) {
      showToast('Special Ability meter too low!');
      return;
    }
    specialActive = !specialActive;
    const fx = document.getElementById('screen-fx-overlay');
    if (fx) {
      if (!specialActive) {
        fx.style.opacity = '0';
      } else {
        if (activeCharId === 'michael') {
          fx.style.background = 'radial-gradient(circle, transparent 40%, rgba(56,189,248,0.38) 100%)';
        } else if (activeCharId === 'franklin') {
          fx.style.background = 'radial-gradient(circle, transparent 40%, rgba(16,185,129,0.38) 100%)';
        } else {
          fx.style.background = 'radial-gradient(circle, transparent 35%, rgba(239,68,68,0.45) 100%)';
        }
        fx.style.opacity = '1';
      }
    }
    const p = PROTAGONISTS[activeCharId];
    showToast(specialActive ? `⚡ ${p.specialName} ACTIVATED!` : `${p.specialName} Deactivated`);
  }

  // ============================================================================
  // 6. COMBAT, WEAPONS, EXPLOSIONS & 5-STAR WANTED POLICE AI
  // ============================================================================
  let lastShotTime = 0;

  function fireWeapon() {
    if (!gameStarted || skyCamActive) return;
    const now = performance.now();
    const w = WEAPONS[activeWeaponIdx] || WEAPONS[1];
    if (now - lastShotTime < w.rate) return;
    if (w.ammo <= 0) {
      showToast('Out of ammo! Visit Ammu-Nation or switch weapon.');
      return;
    }
    lastShotTime = now;
    if (w.ammo !== Infinity) w.ammo--;

    playSFX('shoot');
    const activeMesh = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
    const origin = activeMesh.position.clone().add(new THREE.Vector3(0, 1.3, 0));
    const forward = new THREE.Vector3(Math.sin(activeMesh.rotation.y), 0, Math.cos(activeMesh.rotation.y)).normalize();

    // Spawn visible tracer or rocket projectile
    const projMesh = new THREE.Mesh(
      new THREE.SphereGeometry(w.explosive ? 0.35 : 0.14, 8, 8),
      new THREE.MeshBasicMaterial({ color: w.explosive ? 0xf97316 : 0xfef08a })
    );
    projMesh.position.copy(origin).addScaledVector(forward, 1.8);
    scene.add(projMesh);

    projectiles.push({
      mesh: projMesh,
      vel: forward.multiplyScalar(w.explosive ? 58 : 115),
      dmg: w.dmg * (specialActive && activeCharId === 'trevor' ? 2.5 : (specialActive && activeCharId === 'michael' ? 1.8 : 1)),
      explosive: w.explosive,
      life: 1.4,
    });

    // Firing firearms in public raises Wanted Level if near police or peds
    if (w.id !== 'fists' && Math.random() < 0.35 && wantedLevel === 0) {
      setWantedLevel(1);
    }
    updateHUD();
  }

  function triggerExplosion(pos, radius = 11) {
    playSFX('explosion');
    // Fireball particles
    for (let i = 0; i < 18; i++) {
      const pMesh = new THREE.Mesh(
        new THREE.SphereGeometry(0.45 + Math.random() * 0.6, 6, 6),
        new THREE.MeshBasicMaterial({ color: i % 2 === 0 ? 0xf97316 : 0xfacc15 })
      );
      pMesh.position.copy(pos);
      scene.add(pMesh);
      particles.push({
        mesh: pMesh,
        vel: new THREE.Vector3((Math.random() - 0.5) * 18, 4 + Math.random() * 14, (Math.random() - 0.5) * 18),
        life: 0.75,
      });
    }

    // Damage nearby vehicles, peds, and police
    vehicles.forEach(v => {
      if (v.mesh.position.distanceTo(pos) < radius && v !== currentVehicle) {
        v.hp -= 120;
        v.mesh.position.y += 1.2;
      }
    });
    pedestrians.forEach(p => {
      if (p.hp > 0 && p.mesh.position.distanceTo(pos) < radius) {
        p.hp = 0;
        p.mesh.rotation.x = -Math.PI / 2;
        p.mesh.position.y = 0.2;
        addCash(150, 'Combat Drop');
      }
    });
    policeUnits.forEach(cop => {
      if (cop.mesh.position.distanceTo(pos) < radius) {
        cop.hp = 0;
      }
    });
    if (wantedLevel < 3) setWantedLevel(wantedLevel + 1);
  }

  function setWantedLevel(level) {
    wantedLevel = Math.max(0, Math.min(5, level));
    wantedCooldown = wantedLevel > 0 ? 22 : 0;
    const flash = document.getElementById('radar-wanted-flash');
    const clearBtn = document.getElementById('btn-clear-wanted');
    if (flash) flash.classList.toggle('hidden', wantedLevel === 0);
    if (clearBtn) clearBtn.classList.toggle('hidden', wantedLevel === 0);

    // Spawn LSPD police units matching Wanted Level
    while (policeUnits.length < wantedLevel * 2) {
      const pMesh = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
      const angle = Math.random() * Math.PI * 2;
      const sx = pMesh.position.x + Math.cos(angle) * 55;
      const sz = pMesh.position.z + Math.sin(angle) * 55;
      const copCar = createVehicleEntity('police', sx, sz, angle + Math.PI);
      policeUnits.push({
        veh: copCar,
        mesh: copCar.mesh,
        hp: 120,
      });
    }
    if (wantedLevel === 0) {
      policeUnits.forEach(u => scene.remove(u.mesh));
      policeUnits.length = 0;
    }
    updateHUD();
  }

  // ============================================================================
  // 7. VEHICLE ENTER / EXIT (HIJACKING) & HELICOPTER CONTROLS
  // ============================================================================
  function tryEnterOrExitVehicle() {
    if (!gameStarted || skyCamActive) return;
    const charMesh = protagonistMeshes[activeCharId];

    // If already inside a vehicle, exit right beside it
    if (currentVehicle) {
      charMesh.position.copy(currentVehicle.mesh.position).add(new THREE.Vector3(2.4, 0, 0));
      charMesh.position.y = 0;
      charMesh.visible = true;
      showToast('Exited ' + currentVehicle.name);
      currentVehicle = null;
      updateHUD();
      return;
    }

    // Find closest vehicle within 7.5 meters
    let bestVeh = null;
    let bestDist = 7.5;
    vehicles.forEach(v => {
      const d = v.mesh.position.distanceTo(charMesh.position);
      if (d < bestDist) {
        bestDist = d;
        bestVeh = v;
      }
    });

    if (bestVeh) {
      currentVehicle = bestVeh;
      currentVehicle.isTraffic = false;
      charMesh.visible = false;
      if (bestVeh.isPolice && wantedLevel < 2) setWantedLevel(2);
      showToast('Driving ' + bestVeh.name + (bestVeh.isHeli ? ' (Space/LIFT to Ascend, Shift to Descend)' : ''));
      updateHUD();
    } else {
      showToast('Move closer to a vehicle or use iFruit Cheats (P) to spawn a Supercar/Helicopter.');
    }
  }

  // ============================================================================
  // 8. STORY MISSIONS & HEISTS SYSTEM
  // ============================================================================
  function startMissionById(missionId) {
    const m = MISSIONS.find(x => x.id === missionId) || MISSIONS.find(x => !x.completed) || MISSIONS[0];
    if (m.protagonist !== activeCharId) {
      switchProtagonist(m.protagonist);
    }
    activeMission = m;
    missionStage = 0;
    missionMarkerMesh.position.set(m.targetPos.x, 3, m.targetPos.z);

    // If Cartel or Heist mission, spawn hostile guards near targetPos
    if (m.id === 'm2_cartel' || m.id === 'm4_vangelico' || m.id === 'm5_union') {
      for (let i = 0; i < 4; i++) {
        const gMesh = cloneGLBMesh('/models/character_trevor.glb', '#ef4444');
        gMesh.position.set(m.targetPos.x + (i - 1.5) * 4, 0, m.targetPos.z + (i % 2) * 4);
        scene.add(gMesh);
        pedestrians.push({
          mesh: gMesh,
          hp: 55,
          dir: 0,
          speed: 2.5,
          hostile: true,
          isMissionTarget: true,
        });
      }
    }

    showToast('📋 Mission Started: ' + m.title);
    updateHUD();
    renderPhoneMissions();
  }

  function checkMissionProgress(playerPos) {
    if (!activeMission) {
      // Check if player walked/drove into mission start marker
      const nextM = MISSIONS.find(m => !m.completed) || MISSIONS[0];
      const dist = Math.hypot(playerPos.x - nextM.startPos.x, playerPos.z - nextM.startPos.z);
      if (dist < 6.5) {
        startMissionById(nextM.id);
      }
      return;
    }

    if (missionStage === 0) {
      const dist = Math.hypot(playerPos.x - activeMission.targetPos.x, playerPos.z - activeMission.targetPos.z);
      if (dist < 8.5) {
        missionStage = 1;
        missionMarkerMesh.position.set(activeMission.deliveryPos.x, 3, activeMission.deliveryPos.z);
        if (activeMission.id === 'm4_vangelico' || activeMission.id === 'm5_union') {
          setWantedLevel(3);
          showToast('💎 Loot Secured! Escape the 3-Star LSPD Pursuit to the Drop-Off!');
        } else {
          showToast('✓ Objective Reached! Proceed to the GPS Delivery Point!');
        }
        updateHUD();
      }
    } else if (missionStage === 1) {
      const dist = Math.hypot(playerPos.x - activeMission.deliveryPos.x, playerPos.z - activeMission.deliveryPos.z);
      if (dist < 9.0) {
        completeActiveMission();
      }
    }
  }

  function completeActiveMission() {
    if (!activeMission) return;
    const m = activeMission;
    m.completed = true;
    activeMission = null;
    setWantedLevel(0);
    addCash(m.payout, m.title);

    const banner = document.getElementById('mission-banner');
    const titleEl = document.getElementById('mission-banner-title');
    const subEl = document.getElementById('mission-banner-sub');
    if (banner && titleEl && subEl) {
      titleEl.textContent = m.id.includes('heist') || m.payout >= 250000 ? 'HEIST PASSED' : 'MISSION PASSED';
      subEl.textContent = `+$${m.payout.toLocaleString()} • ${m.title}`;
      banner.classList.remove('hidden');
      setTimeout(() => banner.classList.add('hidden'), 4200);
    }

    const nextM = MISSIONS.find(x => !x.completed) || MISSIONS[0];
    missionMarkerMesh.position.set(nextM.startPos.x, 3, nextM.startPos.z);
    saveGameToStorage();
    updateHUD();
    renderPhoneMissions();
  }

  // ============================================================================
  // 9. MINIMAP RADAR WITH GPS ROUTING & DISTRICT DETECTION
  // ============================================================================
  function getDistrictName(x, z) {
    if (x < -140) return 'VESPUCCI BEACH & PIER';
    if (x > 130) return 'SANDY SHORES AIRFIELD';
    if (z < -130) return 'VINEWOOD HILLS';
    if (z > 110) return 'PORT OF SOUTH LOS SANTOS';
    return 'DOWNTOWN LOS SANTOS';
  }

  function drawRadarMinimap(playerPos, playerRotY) {
    const canvas = document.getElementById('radar-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, w, h);

    ctx.save();
    ctx.translate(w / 2, h / 2);
    const scale = 0.65;

    // Draw Ocean & Sandy Shores zones
    ctx.fillStyle = '#0369a1';
    ctx.fillRect((-450 - playerPos.x) * scale, (-400 - playerPos.z) * scale, 300 * scale, 800 * scale);
    ctx.fillStyle = '#78350f';
    ctx.fillRect((130 - playerPos.x) * scale, (-400 - playerPos.z) * scale, 300 * scale, 800 * scale);

    // Draw Road Grid
    ctx.strokeStyle = '#334155';
    ctx.lineWidth = 5;
    [-120, -60, 0, 60, 120].forEach(r => {
      ctx.beginPath();
      ctx.moveTo((r - playerPos.x) * scale, (-220 - playerPos.z) * scale);
      ctx.lineTo((r - playerPos.x) * scale, (220 - playerPos.z) * scale);
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo((-220 - playerPos.x) * scale, (r - playerPos.z) * scale);
      ctx.lineTo((220 - playerPos.x) * scale, (r - playerPos.z) * scale);
      ctx.stroke();
    });

    // GPS Purple Route Line to Active Mission Marker
    if (missionMarkerMesh) {
      ctx.strokeStyle = '#c084fc';
      ctx.lineWidth = 3;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo((missionMarkerMesh.position.x - playerPos.x) * scale, (missionMarkerMesh.position.z - playerPos.z) * scale);
      ctx.stroke();
      ctx.setLineDash([]);

      // Golden Mission Blip
      ctx.fillStyle = '#facc15';
      ctx.beginPath();
      ctx.arc((missionMarkerMesh.position.x - playerPos.x) * scale, (missionMarkerMesh.position.z - playerPos.z) * scale, 5, 0, Math.PI * 2);
      ctx.fill();
    }

    // LS Customs Wrench Blip
    ctx.fillStyle = '#f59e0b';
    ctx.fillRect((-44 - playerPos.x) * scale - 3, (30 - playerPos.z) * scale - 3, 6, 6);

    // Ammu-Nation Red Blip
    ctx.fillStyle = '#ef4444';
    ctx.fillRect((44 - playerPos.x) * scale - 3, (30 - playerPos.z) * scale - 3, 6, 6);

    // Police Blips (Red/Blue)
    policeUnits.forEach(cop => {
      ctx.fillStyle = (performance.now() % 400 < 200) ? '#ef4444' : '#3b82f6';
      ctx.beginPath();
      ctx.arc((cop.mesh.position.x - playerPos.x) * scale, (cop.mesh.position.z - playerPos.z) * scale, 4, 0, Math.PI * 2);
      ctx.fill();
    });

    // Player Directional Arrow in Center
    ctx.rotate(-playerRotY + Math.PI);
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.moveTo(0, -7);
    ctx.lineTo(5, 6);
    ctx.lineTo(0, 3);
    ctx.lineTo(-5, 6);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  // ============================================================================
  // 10. INPUT HANDLING, UI MODALS & MAIN ANIMATION LOOP
  // ============================================================================
  const keys = {};
  window.addEventListener('keydown', e => {
    keys[e.code] = true;
    if (e.code === 'Digit1') switchProtagonist('michael');
    if (e.code === 'Digit2') switchProtagonist('franklin');
    if (e.code === 'Digit3') switchProtagonist('trevor');
    if (e.code === 'KeyF' || e.code === 'Enter') tryEnterOrExitVehicle();
    if (e.code === 'KeyQ') toggleSpecialAbility();
    if (e.code === 'KeyP') toggleModal('ifruit-phone');
    if (e.code === 'KeyG') toggleModal('lscustoms-modal');
    if (e.code === 'KeyR') toggleModal('radio-wheel-modal');
    if (e.code === 'Tab') {
      e.preventDefault();
      toggleModal('weapon-wheel-modal');
    }
    if (e.code === 'KeyV') {
      cameraMode = (cameraMode + 1) % 3;
      const camLbl = document.getElementById('hud-cam-mode');
      if (camLbl) camLbl.textContent = ['3rd Person', 'Action Close', 'Hood / 1st'][cameraMode];
    }
    if (e.code === 'KeyE' && currentVehicle) {
      currentVehicle.sirenOn = !currentVehicle.sirenOn;
      playSFX('siren');
    }
  });

  window.addEventListener('keyup', e => {
    keys[e.code] = false;
  });

  function toggleModal(id, forceState) {
    const el = document.getElementById(id);
    if (!el) return;
    const hide = forceState !== undefined ? !forceState : !el.classList.contains('hidden');
    el.classList.toggle('hidden', hide);
  }

  function updateHUD() {
    const p = PROTAGONISTS[activeCharId];
    const cashEl = document.getElementById('hud-cash');
    if (cashEl) cashEl.textContent = '$' + p.cash.toLocaleString();

    const w = WEAPONS[activeWeaponIdx] || WEAPONS[1];
    const wNameEl = document.getElementById('hud-active-weapon');
    const wAmmoEl = document.getElementById('hud-active-ammo');
    if (wNameEl) wNameEl.textContent = w.name;
    if (wAmmoEl) wAmmoEl.textContent = '(' + (w.ammo === Infinity ? '∞' : w.ammo) + ')';

    // Bars
    const bh = document.getElementById('bar-health');
    const ba = document.getElementById('bar-armor');
    const bs = document.getElementById('bar-special');
    if (bh) bh.style.width = Math.max(0, playerHealth) + '%';
    if (ba) ba.style.width = Math.max(0, playerArmor) + '%';
    if (bs) bs.style.width = Math.max(0, playerSpecial) + '%';

    // Wanted Stars
    document.querySelectorAll('.wanted-star').forEach(st => {
      const idx = Number(st.getAttribute('data-star'));
      const active = idx <= wantedLevel;
      st.classList.toggle('text-amber-400', active);
      st.classList.toggle('star-blink', active);
      st.classList.toggle('text-slate-700', !active);
    });

    // Character Wheel Highlight
    document.querySelectorAll('.char-wheel-btn').forEach(btn => {
      const isCur = btn.getAttribute('data-char-switch') === activeCharId;
      btn.classList.toggle('border-sky-400', isCur);
      btn.classList.toggle('bg-sky-500/25', isCur);
      btn.classList.toggle('border-white/10', !isCur);
    });

    // Vehicle HUD
    const vPanel = document.getElementById('hud-vehicle-panel');
    if (vPanel) {
      vPanel.classList.toggle('hidden', !currentVehicle);
      if (currentVehicle) {
        document.getElementById('hud-vehicle-name').textContent = currentVehicle.name;
        document.getElementById('hud-vehicle-hp').textContent = Math.max(0, Math.round(currentVehicle.hp)) + '%';
        document.getElementById('btn-toggle-siren').classList.toggle('hidden', !currentVehicle.isPolice);
      }
    }

    // Mission HUD Box
    const mTitle = document.getElementById('hud-mission-title');
    const mDesc = document.getElementById('hud-mission-desc');
    if (mTitle && mDesc) {
      if (activeMission) {
        mTitle.textContent = activeMission.title;
        mDesc.textContent = missionStage === 0 ? activeMission.desc : 'Deliver/Escape to the GPS Destination Marker!';
      } else {
        const nextM = MISSIONS.find(x => !x.completed) || MISSIONS[0];
        mTitle.textContent = 'AVAILABLE: ' + nextM.title;
        mDesc.textContent = nextM.desc;
      }
    }

    // Bank Info in Phone
    const bankBal = document.getElementById('phone-bank-balance');
    const bankHolder = document.getElementById('phone-bank-holder');
    const bankLog = document.getElementById('phone-bank-log');
    if (bankBal) bankBal.textContent = '$' + p.cash.toLocaleString();
    if (bankHolder) bankHolder.textContent = 'Account: ' + p.name;
    if (bankLog) {
      bankLog.innerHTML = bankTransactions.map(t => `<div class="flex justify-between py-1 border-b border-white/5"><span>${t.label}</span><strong class="${t.amount.startsWith('+') ? 'text-emerald-400' : 'text-rose-400'}">${t.amount}</strong></div>`).join('');
    }
  }

  function renderWeaponWheel() {
    const grid = document.getElementById('weapon-wheel-grid');
    if (!grid) return;
    grid.innerHTML = WEAPONS.map((w, idx) => `
      <button type="button" data-weapon-idx="${idx}" class="weapon-slot-btn p-3 rounded-2xl border ${idx === activeWeaponIdx ? 'border-amber-400 bg-amber-500/20' : 'border-white/10 bg-slate-950/70 hover:bg-slate-800'} text-left transition cursor-pointer">
        <div class="text-xs font-bold text-white">${w.name}</div>
        <div class="text-[10px] text-slate-400 mt-1">DMG: ${w.dmg} • Ammo: ${w.ammo === Infinity ? '∞' : w.ammo}</div>
      </button>
    `).join('');
    grid.querySelectorAll('.weapon-slot-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        activeWeaponIdx = Number(btn.getAttribute('data-weapon-idx'));
        updateHUD();
        renderWeaponWheel();
        toggleModal('weapon-wheel-modal', false);
      });
    });
  }

  function renderRadioWheel() {
    const grid = document.getElementById('radio-wheel-grid');
    if (!grid) return;
    grid.innerHTML = RADIO_STATIONS.map((st, idx) => `
      <button type="button" data-radio-idx="${idx}" class="radio-slot-btn p-3 rounded-2xl border ${idx === currentRadioIndex ? 'border-sky-400 bg-sky-500/20' : 'border-white/10 bg-slate-950/70 hover:bg-slate-800'} text-left transition cursor-pointer">
        <div class="text-xs font-bold text-white">📻 ${st.name}</div>
        <div class="text-[10px] text-slate-400 mt-0.5">${st.genre}</div>
      </button>
    `).join('');
    grid.querySelectorAll('.radio-slot-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        ensureAudio();
        updateRadioStation(Number(btn.getAttribute('data-radio-idx')));
        renderRadioWheel();
        toggleModal('radio-wheel-modal', false);
      });
    });
  }

  function renderPhoneMissions() {
    const list = document.getElementById('phone-missions-list');
    if (!list) return;
    list.innerHTML = MISSIONS.map(m => `
      <div class="p-2.5 rounded-xl bg-slate-900 border ${m.completed ? 'border-emerald-500/40' : 'border-white/10'}">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-white">${m.title}</span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded ${m.completed ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}">$${m.payout.toLocaleString()}</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">${m.desc}</p>
        <button type="button" data-launch-mission="${m.id}" class="mt-2 w-full py-1 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-[11px] cursor-pointer">
          ${m.completed ? '↻ Replay Mission / Heist' : '▶ Launch Mission'}
        </button>
      </div>
    `).join('');
    list.querySelectorAll('[data-launch-mission]').forEach(btn => {
      btn.addEventListener('click', () => {
        startMissionById(btn.getAttribute('data-launch-mission'));
        toggleModal('ifruit-phone', false);
      });
    });
  }

  function renderPhoneStocks() {
    const list = document.getElementById('phone-stocks-list');
    if (!list) return;
    list.innerHTML = STOCKS.map((s, idx) => `
      <div class="p-2 rounded-xl bg-slate-900 border border-white/10 flex items-center justify-between">
        <div>
          <div class="text-xs font-bold text-white">${s.ticker} • ${s.name}</div>
          <div class="text-[10px] text-emerald-400">$${s.price.toFixed(2)} • Owned: ${s.owned}</div>
        </div>
        <div class="flex gap-1">
          <button type="button" data-buy-stock="${idx}" class="px-2 py-1 rounded bg-emerald-500 text-slate-950 font-bold text-[10px] cursor-pointer">Buy 10</button>
          <button type="button" data-sell-stock="${idx}" class="px-2 py-1 rounded bg-rose-500 text-white font-bold text-[10px] cursor-pointer">Sell</button>
        </div>
      </div>
    `).join('');
    list.querySelectorAll('[data-buy-stock]').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = STOCKS[Number(btn.getAttribute('data-buy-stock'))];
        const cost = Math.round(s.price * 10);
        if (PROTAGONISTS[activeCharId].cash >= cost) {
          addCash(-cost, `Bought 10 ${s.ticker}`);
          s.owned += 10;
          s.price *= 1.04;
          renderPhoneStocks();
        } else {
          showToast('Insufficient funds for stock purchase!');
        }
      });
    });
    list.querySelectorAll('[data-sell-stock]').forEach(btn => {
      btn.addEventListener('click', () => {
        const s = STOCKS[Number(btn.getAttribute('data-sell-stock'))];
        if (s.owned > 0) {
          const payout = Math.round(s.price * s.owned);
          addCash(payout, `Sold ${s.owned} ${s.ticker}`);
          s.owned = 0;
          renderPhoneStocks();
        }
      });
    });
  }

  function executeCheatCode(code) {
    if (code === 'PAINKILLER') {
      godMode = !godMode;
      showToast('CHEAT ACTIVATED: God Mode ' + (godMode ? 'ON' : 'OFF'));
    } else if (code === 'LAWYERUP') {
      setWantedLevel(0);
      showToast('CHEAT ACTIVATED: Wanted Level Cleared!');
    } else if (code === 'COMET') {
      const activeMesh = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
      createVehicleEntity('sportscar', activeMesh.position.x + 4, activeMesh.position.z + 4, activeMesh.rotation.y, '#e11d48');
      showToast('CHEAT ACTIVATED: Zentorno Supercar Spawned!');
    } else if (code === 'BUZZOFF') {
      const activeMesh = currentVehicle ? currentVehicle.mesh : protagonistMeshes[activeCharId];
      createVehicleEntity('helicopter', activeMesh.position.x + 6, activeMesh.position.z + 6, activeMesh.rotation.y);
      showToast('CHEAT ACTIVATED: Buzzard Attack Helicopter Spawned!');
    } else if (code === 'TURTLE') {
      playerHealth = 100;
      playerArmor = 100;
      playerSpecial = 100;
      if (currentVehicle) currentVehicle.hp = 100;
      updateHUD();
      showToast('CHEAT ACTIVATED: Max Health, Armor & Vehicle Repaired!');
    } else if (code === 'TOOLUP') {
      WEAPONS.forEach(w => {
        w.unlocked = true;
        if (w.ammo !== Infinity) w.ammo += 250;
      });
      activeWeaponIdx = 6; // RPG
      updateHUD();
      showToast('CHEAT ACTIVATED: All Weapons + RPG Ammo Loaded!');
    } else if (code === 'CASHDROP') {
      addCash(250000, 'Cheat Stimulus Deposit');
      showToast('CHEAT ACTIVATED: +$250,000 Deposited!');
    } else if (code === 'FUGITIVE') {
      setWantedLevel(5);
      showToast('CHEAT ACTIVATED: 5-Star LSPD Lockdown!');
    }
  }

  // Trigger Wasted / Hospital Respawn
  let isRespawning = false;
  function triggerWasted(type = 'WASTED') {
    if (isRespawning) return;
    isRespawning = true;
    const ov = document.getElementById('wasted-overlay');
    const tEl = document.getElementById('wasted-title');
    if (ov && tEl) {
      tEl.textContent = type;
      ov.classList.remove('hidden');
    }
    setTimeout(() => {
      playerHealth = 100;
      playerArmor = 100;
      setWantedLevel(0);
      if (currentVehicle) {
        currentVehicle = null;
      }
      const cMesh = protagonistMeshes[activeCharId];
      cMesh.visible = true;
      cMesh.position.set(-10, 0, 15);
      addCash(-500, 'Medical Center Bail/Bill');
      if (ov) ov.classList.add('hidden');
      isRespawning = false;
      updateHUD();
    }, 3000);
  }

  // ============================================================================
  // 11. MAIN GAME LOOP (PHYSICS, AI, DAY/NIGHT, ADAPTIVE LOW-END FPS)
  // ============================================================================
  let lastFrameTime = performance.now();
  let frameCounter = 0;
  let fpsTimer = performance.now();

  function animateLoop(now) {
    requestAnimationFrame(animateLoop);
    if (!scene || !camera || !renderer) return;

    const rawDt = Math.min(0.05, (now - lastFrameTime) / 1000);
    lastFrameTime = now;

    // FPS Counter & Adaptive Scaler
    frameCounter++;
    if (now - fpsTimer >= 1000) {
      const fpsEl = document.getElementById('hud-fps');
      if (fpsEl) fpsEl.textContent = frameCounter + ' FPS';
      if (frameCounter < 28 && gfxPreset === 'balanced') {
        renderer.setPixelRatio(0.75);
      }
      frameCounter = 0;
      fpsTimer = now;
    }

    // Time Scale for Bullet Time / Driving Slow-Mo
    const timeScale = (specialActive && (activeCharId === 'michael' || activeCharId === 'franklin')) ? 0.45 : 1.0;
    const dt = rawDt * timeScale;

    if (ferrisWheelGroup) {
      ferrisWheelGroup.rotation.z += dt * 0.25;
    }
    // Spin vehicle wheels & helicopter/plane rotors (§6.5 node contract)
    vehicles.forEach(v => {
      if (v.rotorNode && (v === currentVehicle || v.mesh.position.y > 0.5)) {
        v.rotorNode.rotation.y += rawDt * 28;
      }
      if (v.wheelNodes && Math.abs(v.speed) > 0.1) {
        v.wheelNodes.forEach(w => { w.rotation.x += v.speed * rawDt * 0.8; });
      }
    });
    // Chromebook IJKL camera look support (§3.5)
    if (keys['KeyJ']) protagonistMeshes[activeCharId].rotation.y += 2.4 * rawDt;
    if (keys['KeyL']) protagonistMeshes[activeCharId].rotation.y -= 2.4 * rawDt;
    // Update Perf HUD overlay (§5.16)
    const cellX = Math.floor((protagonistMeshes[activeCharId]?.position.x || 0) / 256);
    const cellZ = Math.floor((protagonistMeshes[activeCharId]?.position.z || 0) / 256);
    const perfCell = document.getElementById('perf-cell');
    if (perfCell) perfCell.textContent = `C(${cellX},${cellZ}) R0`;
    const perfMs = document.getElementById('perf-ms');
    if (perfMs) perfMs.textContent = (rawDt * 1000).toFixed(1) + ' ms';
    const perfEnts = document.getElementById('perf-ents');
    if (perfEnts) perfEnts.textContent = `${vehicles.length}V ${pedestrians.length}P ${policeUnits.length}C`;

    // Day/Night & Clock Cycle
    timeOfDay = (timeOfDay + rawDt * 0.04) % 24;
    const hr = Math.floor(timeOfDay);
    const mn = Math.floor((timeOfDay - hr) * 60);
    const clk = document.getElementById('hud-clock');
    if (clk) clk.textContent = String(hr).padStart(2, '0') + ':' + String(mn).padStart(2, '0');

    // Update sky color by timeOfDay
    const daylight = Math.max(0.18, Math.sin(((timeOfDay - 5) / 14) * Math.PI));
    if (sunLight && ambientLight) {
      sunLight.intensity = daylight * 1.15;
      ambientLight.intensity = 0.35 + daylight * 0.45;
      const skyColor = new THREE.Color().setHSL(0.58, 0.55, 0.08 + daylight * 0.42);
      scene.background.copy(skyColor);
      if (scene.fog) scene.fog.color.copy(skyColor);
    }

    // Special Ability Bar Drain / Recharge
    if (specialActive) {
      playerSpecial -= rawDt * 12;
      if (playerSpecial <= 0) {
        playerSpecial = 0;
        toggleSpecialAbility();
      }
    } else if (playerSpecial < 100) {
      playerSpecial = Math.min(100, playerSpecial + rawDt * 3.5);
    }

    // Health regeneration up to 50% (authentic GTA 5 mechanic)
    if (playerHealth > 0 && playerHealth < 50) {
      playerHealth = Math.min(50, playerHealth + rawDt * 2.5);
    }

    const charMesh = protagonistMeshes[activeCharId];
    let activePos = charMesh.position;
    let activeRotY = charMesh.rotation.y;

    if (gameStarted && !skyCamActive && !isRespawning) {
      if (currentVehicle) {
        // VEHICLE / HELICOPTER PHYSICS
        const v = currentVehicle;
        const fwd = (keys['KeyW'] || keys['ArrowUp']) ? 1 : ((keys['KeyS'] || keys['ArrowDown']) ? -1 : 0);
        const turn = (keys['KeyA'] || keys['ArrowLeft']) ? 1 : ((keys['KeyD'] || keys['ArrowRight']) ? -1 : 0);

        if ( fwd !== 0 ) {
          v.speed += fwd * v.accel * rawDt;
        } else {
          v.speed *= (1 - Math.min(1, rawDt * 2.5));
        }
        if (keys['Space'] && !v.isHeli) {
          v.speed *= (1 - Math.min(1, rawDt * 7.0)); // Handbrake drift
        }
        v.speed = Math.max(-v.maxSpeed * 0.4, Math.min(v.maxSpeed, v.speed));

        if (Math.abs(v.speed) > 0.5 || v.isHeli) {
          const dirSign = v.speed >= 0 || v.isHeli ? 1 : -1;
          v.mesh.rotation.y += turn * 2.1 * rawDt * dirSign;
        }

        // Helicopter Vertical Climb / Descent
        if (v.isHeli) {
          if (keys['Space']) v.mesh.position.y = Math.min(85, v.mesh.position.y + 18 * rawDt);
          if (keys['ShiftLeft'] || keys['ShiftRight']) v.mesh.position.y = Math.max(0, v.mesh.position.y - 18 * rawDt);
        }

        const nextX = v.mesh.position.x + Math.sin(v.mesh.rotation.y) * v.speed * rawDt;
        const nextZ = v.mesh.position.z + Math.cos(v.mesh.rotation.y) * v.speed * rawDt;

        // Building collision check (unless flying high in helicopter)
        let blocked = false;
        if (v.mesh.position.y < 10) {
          for (const b of buildingBoxes) {
            if (nextX > b.minX && nextX < b.maxX && nextZ > b.minZ && nextZ < b.maxZ) {
              blocked = true;
              v.speed *= -0.35;
              v.hp = Math.max(10, v.hp - 3);
              break;
            }
          }
        }
        if (!blocked) {
          v.mesh.position.x = Math.max(-420, Math.min(420, nextX));
          v.mesh.position.z = Math.max(-420, Math.min(420, nextZ));
        }

        charMesh.position.copy(v.mesh.position);
        charMesh.rotation.y = v.mesh.rotation.y;
        activePos = v.mesh.position;
        activeRotY = v.mesh.rotation.y;

        const spdEl = document.getElementById('hud-speed-mph');
        if (spdEl) spdEl.textContent = Math.round(Math.abs(v.speed) * 2.4);
      } else {
        // ON-FOOT PROTAGONIST MOVEMENT
        const fwd = (keys['KeyW'] || keys['ArrowUp']) ? 1 : ((keys['KeyS'] || keys['ArrowDown']) ? -1 : 0);
        const turn = (keys['KeyA'] || keys['ArrowLeft']) ? 1 : ((keys['KeyD'] || keys['ArrowRight']) ? -1 : 0);
        if (turn !== 0) {
          charMesh.rotation.y += turn * 3.0 * rawDt;
        }
        if (fwd !== 0) {
          const walkSpeed = (keys['ShiftLeft'] || keys['ShiftRight']) ? 13.5 : 8.5;
          const nx = charMesh.position.x + Math.sin(charMesh.rotation.y) * fwd * walkSpeed * rawDt;
          const nz = charMesh.position.z + Math.cos(charMesh.rotation.y) * fwd * walkSpeed * rawDt;
          let hitBldg = false;
          for (const b of buildingBoxes) {
            if (nx > b.minX && nx < b.maxX && nz > b.minZ && nz < b.maxZ) {
              hitBldg = true;
              break;
            }
          }
          if (!hitBldg) {
            charMesh.position.x = nx;
            charMesh.position.z = nz;
          }
        }
        activePos = charMesh.position;
        activeRotY = charMesh.rotation.y;
      }

      // Contextual HUD Prompts (Nearby Vehicle, LS Customs, Ammu-Nation)
      const promptBox = document.getElementById('hud-context-prompt');
      const promptTxt = document.getElementById('hud-context-text');
      if (promptBox && promptTxt) {
        const distLSC = Math.hypot(activePos.x + 44, activePos.z - 30);
        const distAmmu = Math.hypot(activePos.x - 44, activePos.z - 30);
        if (distLSC < 7.0) {
          promptTxt.textContent = '🔧 Press [G] to enter Los Santos Customs Mod Shop';
          promptBox.classList.remove('hidden');
          promptBox.onclick = () => toggleModal('lscustoms-modal', true);
        } else if (distAmmu < 7.0) {
          promptTxt.textContent = '🎯 Click or Open Ammu-Nation Weapon Shop';
          promptBox.classList.remove('hidden');
          promptBox.onclick = () => toggleModal('ammunation-modal', true);
        } else if (!currentVehicle) {
          let nearV = null;
          vehicles.forEach(v => {
            if (v.mesh.position.distanceTo(activePos) < 6.5) nearV = v;
          });
          if (nearV) {
            promptTxt.textContent = `🚗 Press [F] to Hijack / Enter ${nearV.name}`;
            promptBox.classList.remove('hidden');
            promptBox.onclick = () => tryEnterOrExitVehicle();
          } else {
            promptBox.classList.add('hidden');
          }
        } else {
          promptBox.classList.add('hidden');
        }
      }

      // Camera Follow System (3 Modes)
      const camDist = cameraMode === 0 ? (currentVehicle ? 12.5 : 8.5) : (cameraMode === 1 ? 5.5 : 0.4);
      const camHeight = cameraMode === 0 ? (currentVehicle ? 5.2 : 3.6) : (cameraMode === 1 ? 2.4 : 1.7);
      const targetCamX = activePos.x - Math.sin(activeRotY) * camDist;
      const targetCamZ = activePos.z - Math.cos(activeRotY) * camDist;
      const targetCamY = activePos.y + camHeight;
      camera.position.lerp(new THREE.Vector3(targetCamX, targetCamY, targetCamZ), 0.16);
      const lookTarget = new THREE.Vector3(
        activePos.x + Math.sin(activeRotY) * 8,
        activePos.y + 1.4,
        activePos.z + Math.cos(activeRotY) * 8
      );
      camera.lookAt(lookTarget);

      // Update District Name & Mission Check
      const distEl = document.getElementById('hud-district');
      if (distEl) distEl.textContent = getDistrictName(activePos.x, activePos.z);
      checkMissionProgress(activePos);
      drawRadarMinimap(activePos, activeRotY);
    }

    // Update Ambient Traffic Vehicles
    vehicles.forEach(v => {
      if (v.isTraffic && v !== currentVehicle && v.hp > 0) {
        v.mesh.position.z += v.speed * dt;
        if (v.mesh.position.z > 190) v.mesh.position.z = -190;
      }
    });

    // Update Pedestrians & Hostile Enforcers
    pedestrians.forEach(p => {
      if (p.hp <= 0) return;
      p.mesh.position.x += Math.sin(p.dir) * p.speed * dt;
      p.mesh.position.z += Math.cos(p.dir) * p.speed * dt;
      if (Math.random() < 0.01) p.dir += (Math.random() - 0.5) * 1.5;

      // Run over collision check when driving fast
      if (currentVehicle && Math.abs(currentVehicle.speed) > 8 && currentVehicle.mesh.position.y < 3) {
        if (p.mesh.position.distanceTo(activePos) < 2.3) {
          p.hp = 0;
          p.mesh.rotation.x = -Math.PI / 2;
          p.mesh.position.y = 0.2;
          addCash(85, 'Street Cash Drop');
          if (wantedLevel === 0) setWantedLevel(1);
        }
      }

      // Hostile guards shoot at player
      if (p.hostile && p.mesh.position.distanceTo(activePos) < 35 && Math.random() < 0.025) {
        if (!godMode) {
          const dmg = (specialActive && activeCharId === 'trevor') ? 2 : 5;
          if (playerArmor > 0) playerArmor = Math.max(0, playerArmor - dmg);
          else playerHealth = Math.max(0, playerHealth - dmg);
          if (playerHealth <= 0) triggerWasted('WASTED');
          updateHUD();
        }
      }
    });

    // Update Police Pursuit AI & Wanted Cooldown
    if (wantedLevel > 0) {
      let seenByCops = false;
      policeUnits.forEach(cop => {
        if (cop.hp <= 0) return;
        const dx = activePos.x - cop.mesh.position.x;
        const dz = activePos.z - cop.mesh.position.z;
        const dist = Math.hypot(dx, dz);
        if (dist < 68) seenByCops = true;

        const targetAngle = Math.atan2(dx, dz);
        cop.mesh.rotation.y = targetAngle;
        const copSpd = (18 + wantedLevel * 3.2) * dt;
        cop.mesh.position.x += Math.sin(targetAngle) * copSpd;
        cop.mesh.position.z += Math.cos(targetAngle) * copSpd;

        // Cop attacks / rams player when close
        if (dist < 9.5 && Math.random() < 0.04 && !godMode) {
          if (playerArmor > 0) playerArmor = Math.max(0, playerArmor - 4);
          else playerHealth = Math.max(0, playerHealth - 4);
          if (playerHealth <= 0) triggerWasted(wantedLevel === 1 && !currentVehicle ? 'BUSTED' : 'WASTED');
          updateHUD();
        }
      });

      if (!seenByCops) {
        wantedCooldown -= rawDt;
        if (wantedCooldown <= 0) {
          setWantedLevel(0);
          showToast('★ Police Evaded! Wanted Level Cleared.');
        }
      } else {
        wantedCooldown = 18;
      }
    }

    // Update Projectiles
    for (let i = projectiles.length - 1; i >= 0; i--) {
      const pr = projectiles[i];
      pr.life -= rawDt;
      pr.mesh.position.addScaledVector(pr.vel, rawDt);

      let hit = false;
      // Check hit against peds
      for (const p of pedestrians) {
        if (p.hp > 0 && p.mesh.position.distanceTo(pr.mesh.position) < 1.8) {
          p.hp -= pr.dmg;
          hit = true;
          if (p.hp <= 0) {
            p.mesh.rotation.x = -Math.PI / 2;
            p.mesh.position.y = 0.2;
            addCash(p.isMissionTarget ? 1000 : 120, 'Target Eliminated');
          }
          break;
        }
      }
      // Check hit against vehicles
      if (!hit) {
        for (const v of vehicles) {
          if (v !== currentVehicle && v.mesh.position.distanceTo(pr.mesh.position) < 2.6) {
            v.hp -= pr.dmg;
            hit = true;
            if (v.hp <= 0) triggerExplosion(v.mesh.position.clone());
            break;
          }
        }
      }

      if (hit || pr.life <= 0 || pr.mesh.position.y <= 0.1) {
        if (pr.explosive) triggerExplosion(pr.mesh.position.clone());
        scene.remove(pr.mesh);
        projectiles.splice(i, 1);
      }
    }

    // Update Explosion Particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const pt = particles[i];
      pt.life -= rawDt;
      pt.mesh.position.addScaledVector(pt.vel, rawDt);
      pt.mesh.scale.multiplyScalar(0.95);
      if (pt.life <= 0) {
        scene.remove(pt.mesh);
        particles.splice(i, 1);
      }
    }

    renderer.render(scene, camera);
  }

  // ============================================================================
